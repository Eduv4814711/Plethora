[Unit]
Description=Plethora ERP Next.js Web Application
After=network-online.target plethora-api.service
Wants=network-online.target

[Service]
Type=simple
User=plethora
Group=plethora
WorkingDirectory=/opt/plethora/current/apps/web
EnvironmentFile=/run/plethora/web.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
ExecStart=/usr/bin/node /opt/plethora/current/node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port 3000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plethora-web
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
