[Unit]
Description=Plethora ERP Fastify API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=plethora
Group=plethora
WorkingDirectory=/opt/plethora/current/apps/api
EnvironmentFile=/run/plethora/env
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOST=0.0.0.0
Environment=NODE_EXTRA_CA_CERTS=/etc/ssl/certs/rds-global-bundle.pem
Environment=PUPPETEER_SKIP_DOWNLOAD=true
Environment=PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plethora-api
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
