# Plethora API — AWS EC2 (non-Docker) production environment template
#
# This file targets the EC2 + PM2 + ALB + RDS + S3 deployment described in
# docs/AWS_EC2_NON_DOCKER_DEPLOYMENT.md. It is NOT for Docker/ECS.
#
# On the EC2 host, copy this to the real env file the API reads:
#   cp apps/api/.env.production.example apps/api/.env
# then fill in the real values. NEVER commit a filled-in copy or any secret.

# Standard Node production flag. Enables strict env validation + secure headers.
NODE_ENV=production

# Bind to all interfaces so the ALB (in the same VPC) can reach the API.
# The EC2 security group — not the bind address — is what keeps port 3001 private.
HOST=0.0.0.0
PORT=3001

# Tell Fastify to trust X-Forwarded-* headers from the AWS ALB.
# Required so real client IP, protocol (https), rate limiting, and secure
# cookies work correctly behind the load balancer. See app.ts / env.ts.
TRUST_PROXY=true

# RDS PostgreSQL connection string. Use the RDS endpoint (private subnet),
# a dedicated DB user, and sslmode=require since RDS enforces TLS.
DATABASE_URL="postgresql://plethora_user:CHANGE_ME@YOUR_RDS_ENDPOINT:5432/plethora?schema=public&sslmode=require"

# JWT signing secrets. MUST be two DIFFERENT random strings, each >= 32 chars.
# Generate with: openssl rand -base64 48
# Production startup will refuse to boot if these are weak, equal, or placeholders.
JWT_SECRET="CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_DIFFERENT_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"

# Browser origin allowed by CORS (the public web app URL, no trailing slash).
# Comma-separate if you serve the app from multiple origins.
CORS_ORIGIN="https://app.plethora.quickbophasecurity.co.za"
# Public web URL used for invite / password-setup links (usually same as CORS_ORIGIN).
FRONTEND_URL="https://app.plethora.quickbophasecurity.co.za"

# Storage backend. Use s3 in production so uploads survive instance replacement.
STORAGE_DRIVER=s3
# AWS region of the S3 bucket (and the EC2 instance). Cape Town = af-south-1.
AWS_REGION=af-south-1
# Target S3 bucket for uploads (logos, task attachments, academy documents).
S3_BUCKET_NAME=plethora-prod-uploads
# Optional CDN/custom base URL for public objects (e.g. a CloudFront domain).
# Leave empty to use the default https://<bucket>.s3.<region>.amazonaws.com URLs.
S3_PUBLIC_BASE_URL=
#
# NOTE: Do NOT put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here.
# Attach an IAM role to the EC2 instance instead; the AWS SDK picks it up
# automatically via the instance metadata credential chain.

# WhatsApp Cloud API (Meta). Optional until you enable WhatsApp messaging.
# See docs/WHATSAPP_PRODUCTION.md for setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Attendance: minutes before shift start that clock-in is allowed (default 15).
CLOCK_IN_WINDOW_MINUTES=15

# Required only if encrypted SMTP settings are stored in the DB (>= 16 chars).
ENCRYPTION_KEY=

# Chromium path for HTML->PDF generation (puppeteer-core). On Ubuntu install
# chromium-browser; adjust the path if your distro uses /usr/bin/chromium.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
