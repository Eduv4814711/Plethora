{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "prisma generate && tsc && node scripts/copy-templates.mjs",
    "start": "prisma migrate deploy && node dist/index.js",
    "start:server": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:resolve-baseline-applied": "prisma migrate resolve --applied 20240101000000_baseline",
    "db:check-email-unique": "tsx prisma/check-duplicate-emails.ts",
    "db:add-module-access": "prisma db execute --file prisma/sql/add_user_module_access_column.sql --schema prisma/schema.prisma",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "import:employees": "tsx scripts/import-employees-csv.ts",
    "db:create-site-groups": "tsx scripts/create-site-employee-groups.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^9.0.0",
    "@fastify/multipart": "^8.2.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "csv-parse": "^6.1.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.4",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "jsonwebtoken": "^9.0.2",
    "mime": "^4.0.7",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "pdf-lib": "^1.17.1",
    "prisma": "^5.22.0",
    "puppeteer": "^23.11.1",
    "puppeteer-core": "^23.11.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.0"
  }
}
