{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "prisma generate && tsc && node scripts/copy-templates.mjs && npx puppeteer browsers install chrome",
    "start": "node dist/index.js",
    "start:server": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "node scripts/deploy-migrations.mjs",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:resolve-baseline-applied": "prisma migrate resolve --applied 20240101000000_baseline",
    "db:migrate:resolve-roster-v2-rolled-back": "prisma migrate resolve --rolled-back 20260627120000_roster_module_v2",
    "db:check-email-unique": "tsx prisma/check-duplicate-emails.ts",
    "db:push": "prisma db push",
    "db:check": "node scripts/check-database.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-admin": "tsx prisma/reset-admin.ts",
    "db:expand-grants": "tsx prisma/expand-implicit-grants.ts",
    "gen:catalog": "node scripts/generate-web-catalog.mjs",
    "db:studio": "prisma studio",
    "import:employees": "tsx scripts/import-employees-csv.ts",
    "db:create-site-groups": "tsx scripts/create-site-employee-groups.ts",
    "db:cleanup-attendance-duplicates": "node scripts/cleanup-attendance-duplicates.mjs",
    "db:audit": "node scripts/data-audit/run-all.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "csv-parse": "^7.0.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mime": "^4.1.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.3.0",
    "puppeteer-core": "^25.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24",
    "prisma": "^7.8.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
