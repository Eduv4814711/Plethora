# Optional: custom writable directory for uploads (default: ./uploads under the API cwd)
# UPLOADS_DIR=

DATABASE_URL="postgresql://user:password@localhost:5432/plethora?schema=public"
# Linux local dev (peer auth, no password): use Unix socket instead of TCP:
# DATABASE_URL="postgresql://YOUR_LINUX_USER@localhost/plethora?host=/var/run/postgresql&schema=public"
# Remote (Railway): copy DATABASE_URL from your Railway Postgres service variables.
# Avoid stale Prisma Postgres (db.prisma.io) URLs unless that database is active and reachable.
JWT_SECRET="change-this-in-production"
JWT_REFRESH_SECRET="change-this-refresh-in-production"
# Production (Railway, etc.): with NODE_ENV=production, JWT_* must be two different random
# strings of at least 32 characters — not the placeholders above or the dev-* defaults in app code.
# Comma-separated list is supported for multiple browser origins.
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
PORT=3001

# WhatsApp Cloud API (Meta) - required for production
# See docs/WHATSAPP_PRODUCTION.md for setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=          # Use permanent token from Meta System User
WHATSAPP_VERIFY_TOKEN=          # Must match Meta webhook verify token
WHATSAPP_APP_SECRET=            # Meta app secret — required for webhook signature verification in production
WHATSAPP_API_VERSION=v21.0

# Optional: Chromium/Chrome for PDFs with puppeteer-core
# PUPPETEER_EXECUTABLE_PATH=

# Optional: Clock-in window in minutes (default 15)
# CLOCK_IN_WINDOW_MINUTES=15

# Email config encryption (32-byte hex or passphrase for SMTP password storage)
# ENCRYPTION_KEY=

# Database seed/reset identities. The scripts require both values, refuse weak
# passwords, and never print passwords.
# SEED_ADMIN_EMAIL=admin@example.test
# SEED_ADMIN_PASSWORD=replace-with-32-random-characters
# RESET_ADMIN_EMAIL=admin@example.test
# RESET_ADMIN_PASSWORD=replace-with-32-random-characters
