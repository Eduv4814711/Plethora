# Plethora API — AWS ECS Fargate environment template
#
# Copy for local reference only — do NOT commit a filled-in copy:
#   cp apps/api/.env.aws.example apps/api/.env.aws
#
# In AWS, inject values via ECS task definition (environment + secrets).
# See docs/AWS_ENVIRONMENT_VARIABLES.md for Secrets Manager vs SSM guidance.
#
# Do not commit real secrets. Add apps/api/.env.aws to .gitignore if you create one locally.

NODE_ENV=production

# RDS PostgreSQL connection string (private subnet endpoint; use ?sslmode=require when enforced)
DATABASE_URL=

# Two different random strings, each at least 32 characters (Secrets Manager)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated browser origin(s) for the web app (scheme + host, no trailing slash)
# Example: https://app.example.com
CORS_ORIGIN=

# Public web URL for invite / setup-password links (usually same origin as CORS_ORIGIN)
FRONTEND_URL=

HOST=0.0.0.0
PORT=3001

# local (default) = disk under UPLOADS_DIR; s3 = AWS S3 (+ optional CloudFront base URL)
STORAGE_DRIVER=local
AWS_REGION=
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Attendance: minutes before shift start that clock-in is allowed (default 15)
CLOCK_IN_WINDOW_MINUTES=15

# Required only if encrypted SMTP settings are stored in the database (≥16 characters)
ENCRYPTION_KEY=

# Optional — not in the minimal AWS checklist but commonly set on ECS:
# RUN_MIGRATIONS=false          # true only on one-off migration tasks
# UPLOADS_DIR=/app/apps/api/uploads   # EFS mount path when not using S3
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium   # set in Dockerfile.api
