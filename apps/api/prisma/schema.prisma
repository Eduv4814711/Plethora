enum ClientQuoteStatus {
  draft
  issued
  accepted
  declined
  expired
  cancelled
}

enum ClientInvoiceStatus {
  draft
  issued
  partially_paid
  paid
  overdue
  cancelled
}

/// Quote issued to a client. Amounts are VAT-exclusive; VAT is applied after discount.
model ClientQuote {
  id              String            @id @default(cuid())
  companyId       String
  clientId        String?
  prospectName    String?
  prospectEmail   String?
  prospectPhone   String?
  prospectAddress String?           @db.Text
  siteId          String?
  quoteNumber     String
  quoteDate       DateTime          @db.Date
  validUntil      DateTime          @db.Date
  reference       String?
  notes           String?           @db.Text
  subtotal        Decimal           @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal           @default(0) @db.Decimal(12, 2)
  vatRate         Decimal           @default(15.00) @db.Decimal(5, 2)
  vatAmount       Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal           @default(0) @db.Decimal(12, 2)
  status          ClientQuoteStatus @default(draft)
  issuedAt        DateTime?
  decidedAt       DateTime?
  decidedByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client?           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  site      Site?             @relation("ClientQuoteSite", fields: [siteId], references: [id], onDelete: SetNull)
  decidedBy User?             @relation("ClientQuoteDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  items     ClientQuoteLine[]
  invoices  ClientInvoice[]

  @@unique([companyId, quoteNumber])
  @@index([companyId, status])
  @@index([clientId])
  @@index([siteId])
  @@index([companyId, quoteDate])
  @@index([companyId, prospectName])
}

model ClientQuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  /// Optional source site — set by the "pull in client sites" preset, drives per-site history.
  siteId      String?
  description String
  /// Decimal (not Int) — guarding bills in part-months / part-headcount.
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitAmount  Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  quote ClientQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  site  Site?       @relation("ClientQuoteLineSite", fields: [siteId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([siteId])
}

/// Tax invoice issued to a client. Amounts are VAT-exclusive; VAT is applied after discount.
model ClientInvoice {
  id             String              @id @default(cuid())
  companyId      String
  clientId       String
  /// Set when this invoice was generated from an accepted quote.
  quoteId        String?
  siteId         String?
  invoiceNumber  String
  invoiceDate    DateTime            @db.Date
  dueDate        DateTime            @db.Date
  reference      String?
  notes          String?             @db.Text
  subtotal       Decimal             @default(0) @db.Decimal(12, 2)
  discountAmount Decimal             @default(0) @db.Decimal(12, 2)
  vatRate        Decimal             @default(15.00) @db.Decimal(5, 2)
  vatAmount      Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal             @default(0) @db.Decimal(12, 2)
  status         ClientInvoiceStatus @default(draft)
  issuedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client   Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  site     Site?               @relation("ClientInvoiceSite", fields: [siteId], references: [id], onDelete: SetNull)
  quote    ClientQuote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  items    ClientInvoiceLine[]
  payments ClientPayment[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@index([clientId])
  @@index([siteId])
  @@index([quoteId])
  @@index([companyId, dueDate])
  @@index([companyId, invoiceDate])
}

model ClientInvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  siteId      String?
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitAmount  Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  invoice ClientInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  site    Site?         @relation("ClientInvoiceLineSite", fields: [siteId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([siteId])
}

model ClientPayment {
  id               String   @id @default(cuid())
  companyId        String
  invoiceId        String
  clientId         String
  paymentDate      DateTime @db.Date
  amount           Decimal  @db.Decimal(12, 2)
  paymentMethod    String? // eft | cash | card | debit_order
  referenceNumber  String?
  notes            String?  @db.Text
  recordedByUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice    ClientInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  client     Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  recordedBy User           @relation("ClientPaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  receipt    ClientReceipt?

  @@index([companyId, paymentDate])
  @@index([invoiceId])
  @@index([clientId])
}

model ClientReceipt {
  id             String   @id @default(cuid())
  companyId      String
  paymentId      String   @unique
  receiptNumber  String
  receiptDate    DateTime @db.Date
  amount         Decimal  @db.Decimal(12, 2)
  issuedByUserId String
  createdAt      DateTime @default(now())

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payment  ClientPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  issuedBy User          @relation("ClientReceiptIssuedBy", fields: [issuedByUserId], references: [id], onDelete: Restrict)

  @@unique([companyId, receiptNumber])
  @@index([companyId, receiptDate])
}

enum SiteBillingMethod {
  PER_GUARD
}

/// Effective-dated billing rate configured for a site under a client. Managed strictly by Finance in Client Billing.
model SiteBillingRate {
