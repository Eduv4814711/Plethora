  doesChangeBasePattern Boolean              @default(false)
  createdBy             String?
  createdAt             DateTime             @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  guard   Employee @relation(fields: [guardId], references: [id], onDelete: Cascade)

  @@unique([siteId, guardId, rosterDate])
  @@index([companyId, siteId, rosterDate])
}

model SiteRosterGeneratedShift {
  id               String                    @id @default(cuid())
  companyId        String
  siteId           String
  guardId          String
  rosterDate       DateTime                  @db.Date
  shiftCode        SiteRosterShiftCode
  shiftType        SiteRosterShiftType
  source           SiteRosterGeneratedSource @default(pattern)
  rosterPatternId  String?
  sitePostId       String?
  publishedShiftId String?                   @unique
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  guard          Employee  @relation(fields: [guardId], references: [id], onDelete: Cascade)
  sitePost       SitePost? @relation(fields: [sitePostId], references: [id], onDelete: SetNull)
  publishedShift Shift?    @relation("RosterPublishedShift", fields: [publishedShiftId], references: [id], onDelete: SetNull)

  @@unique([siteId, guardId, rosterDate])
  @@index([companyId, siteId, rosterDate])
}

