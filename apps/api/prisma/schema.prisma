model OperationalAlert {
  id             String            @id @default(cuid())
  companyId      String
  title          String
  message        String
  priority       AlertPriority
  status         AlertStatus       @default(OPEN)
  sourceModule   AlertSourceModule
  /// Deduplication key e.g. "missed_clock_in:shiftId:abc"
  dedupeKey      String?
  sourceId       String?
  assignedToId   String?
  siteId         String?
  employeeId     String?
  metadata       Json?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo User?     @relation("AlertAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy User?     @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  site       Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([companyId, dedupeKey])
  @@index([companyId, status, priority])
  @@index([companyId, sourceModule])
  @@index([siteId])
  @@index([assignedToId])
  @@index([createdAt])
}

enum AttendanceExceptionType {
