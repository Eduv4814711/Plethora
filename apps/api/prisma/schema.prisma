enum AccessChangeStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum AccessChangeKind {
  CREATE_USER
  UPDATE_ACCESS
  DEACTIVATE_USER
}

/// A user-access change proposed by an access manager and awaiting the company
/// owner's decision. Nothing recorded here is in force: User.capabilities is only
/// written when the owner approves.
model AccessChangeRequest {
  id        String             @id @default(cuid())
  companyId String
  kind      AccessChangeKind
  status    AccessChangeStatus @default(PENDING)

  /// Null for CREATE_USER — the account does not exist until the change is approved.
  targetUserId String?
  /// Name/email snapshot so a decided request still reads correctly later.
  targetLabel  String

  /// Full proposed state (profile fields + capability map). Applied verbatim on approval.
  payload     Json
  /// The target's profile and capabilities at submit time, used to detect drift
  /// before a stale proposal is applied.
  beforeState Json

  requestedById String
  requestedAt   DateTime  @default(now())
  requestNote   String?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  targetUser  User?   @relation("AccessChangeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("AccessChangeRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy  User?   @relation("AccessChangeReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)


  @@index([companyId, status, requestedAt])
  @@index([companyId, targetUserId, status])
  @@index([requestedById, status])
}

// =============================================================================
// Operational Compliance & Legal Register
// =============================================================================

enum ComplianceObligationType {
  PSIRA_COMPANY
  DIRECTOR_VETTING
  EMPLOYEE_PSIRA
  NBCPSS
  SARS_TAX_CLEARANCE
  COIDA
  UIF
  PSSPF
  PUBLIC_LIABILITY
  POPIA
  OTHER
}

enum ComplianceObligationStatus {
  COMPLIANT
  ATTENTION_REQUIRED
  NON_COMPLIANT
  PENDING_VERIFICATION
  NOT_APPLICABLE
}

enum ComplianceRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LegalCaseType {
  CCMA
  LABOUR_COURT
  REGULATORY
  EMPLOYEE_DISPUTE
  OTHER
}

enum LegalCaseStatus {
  OPEN
  IN_PROGRESS
  AWAITING_OUTCOME
  SETTLED
  CLOSED
  WITHDRAWN
}

enum RemediationPlanStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
  SUSPENDED
}

enum RemediationFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
}

/// Company-level compliance obligation register (PSiRA cert, tax clearance, insurance, POPIA, etc.)
model ComplianceObligation {
  id                        String                     @id @default(cuid())
  companyId                 String
  type                      ComplianceObligationType
  title                     String
  authority                 String?
  referenceNumber           String?
  status                    ComplianceObligationStatus @default(PENDING_VERIFICATION)
  riskLevel                 ComplianceRiskLevel        @default(MEDIUM)
  ownerUserId               String?
  effectiveDate             DateTime?                  @db.Date
  dueDate                   DateTime?                  @db.Date
  expiryDate                DateTime?                  @db.Date
  expectedAmount            Decimal?                   @db.Decimal(14, 2)
  paidAmount                Decimal?                   @db.Decimal(14, 2)
  notes                     String?                    @db.Text
  primaryEvidenceDocumentId String?
  lastVerifiedAt            DateTime?
  verifiedById              String?
  managementOverrideReason  String?                    @db.Text
  managementOverrideById    String?
  managementOverrideAt      DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  company            Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner              User?                       @relation("ObligationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  verifiedBy         User?                       @relation("ObligationVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  managementOverride User?                       @relation("ObligationManagementOverride", fields: [managementOverrideById], references: [id], onDelete: SetNull)
  remediationPlans   ComplianceRemediationPlan[]

  @@index([companyId, type])
  @@index([companyId, status])
  @@index([companyId, expiryDate])
  @@index([ownerUserId])
}

/// Remediation / repayment plan for compliance obligations.
model ComplianceRemediationPlan {
  id                         String                @id @default(cuid())
  companyId                  String
  obligationId               String?
  scheme                     String?
  title                      String
  originalBalance            Decimal               @db.Decimal(14, 2)
  currentBalance             Decimal               @db.Decimal(14, 2)
  installmentAmount          Decimal               @db.Decimal(14, 2)
  frequency                  RemediationFrequency
  startDate                  DateTime              @db.Date
  endDate                    DateTime?             @db.Date
  nextPaymentDate            DateTime?             @db.Date
  status                     RemediationPlanStatus @default(ACTIVE)
  externalAgreementReference String?
  primaryEvidenceDocumentId  String?
  ownerUserId                String?
  notes                      String?               @db.Text
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  obligation ComplianceObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  owner      User?                 @relation("RemediationPlanOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, nextPaymentDate])
  @@index([obligationId])
}

/// CCMA, Labour Court, regulatory, and employee dispute case register.
model ComplianceLegalCase {
  id                String              @id @default(cuid())
  companyId         String
  employeeId        String?
  caseNumber        String
  caseType          LegalCaseType
  title             String
  description       String?             @db.Text
  riskLevel         ComplianceRiskLevel @default(MEDIUM)
  status            LegalCaseStatus     @default(OPEN)
  dateReceived      DateTime            @db.Date
  nextEventDate     DateTime?           @db.Date
  assignedToId      String?
  nextAction        String?             @db.Text
  primaryDocumentId String?
  outcome           String?             @db.Text
  closedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("LegalCaseAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@unique([companyId, caseNumber])
  @@index([companyId, status])
  @@index([companyId, riskLevel])
  @@index([companyId, nextEventDate])
  @@index([employeeId])
  @@index([assignedToId])
}

/// Termination workflow tracker for HR and external payroll exits.
model EmploymentExit {
  id                            String   @id @default(cuid())
  companyId                     String
  employeeId                    String
  lastWorkingDate               DateTime @db.Date
  reason                        String?
  siteId                        String?
  redeployed                    Boolean  @default(false)
  newSiteId                     String?
  terminationStatus             String   @default("pending")
  uifDeclarationCompleted       Boolean  @default(false)
  certificateOfServiceCompleted Boolean  @default(false)
  finalPayrollCompleted         Boolean  @default(false)
  notes                         String?  @db.Text
  processedById                 String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  site        Site?    @relation("EmploymentExitSite", fields: [siteId], references: [id], onDelete: SetNull)
  newSite     Site?    @relation("EmploymentExitNewSite", fields: [newSiteId], references: [id], onDelete: SetNull)
  processedBy User?    @relation("EmploymentExitProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([employeeId])
  @@index([companyId, terminationStatus])
}
/// Append-only ledger of every attendance capture and correction (WhatsApp, manual, REST).
/// Rows are never updated or deleted, and deliberately have no FKs so history survives
/// shift/attendance deletion. (whatsappMessageId, eventType) is unique so a replayed
/// webhook can never record the same clock event twice.
model AttendanceEvent {
  id                String   @id @default(cuid())
  companyId         String
  attendanceId      String?
  shiftId           String?
  employeeId        String?
  siteId            String?
  /// CLOCK_IN | CLOCK_OUT | MANUAL_CAPTURE | MANUAL_CORRECTION | MARK_ABSENT | REJECTED_GEOFENCE | NO_SHIFT | DUPLICATE
  eventType         String
  /// whatsapp | manual | rest
  source            String
  /// The clock timestamp this event is about (not when it was written).
  occurredAt        DateTime?
  before            Json?
  after             Json?
  reason            String?
  actorUserId       String?
  whatsappMessageId String?
  metadata          Json?
  createdAt         DateTime @default(now())

  @@unique([whatsappMessageId, eventType])
  @@index([companyId, createdAt])
  @@index([attendanceId])
  @@index([shiftId])
  @@index([employeeId, createdAt])
}

// =============================================================================
// External Payroll Export (Sage Business Cloud / VIP / 300 People / Generic)
// =============================================================================

enum PayrollExportProvider {
  SAGE_BUSINESS_CLOUD_ZA
  SAGE_VIP
  SAGE_300_PEOPLE
  GENERIC_CSV
  JSON_WEBHOOK
}

enum PayrollExportBatchStatus {
  DRAFT
  LOCKED
  EXPORTED
  VOIDED
}

model PayrollExportProfile {
  id                String                @id @default(cuid())
  companyId         String
  name              String
  provider          PayrollExportProvider @default(SAGE_BUSINESS_CLOUD_ZA)
  isDefault         Boolean               @default(false)
  splitBySite       Boolean               @default(true)
  delimiter         String                @default(",")
  dateFormat        String                @default("yyyy-MM-dd")
  /// Maps Plethora hour/leave buckets to external payroll earning/leave codes
  codeMappingJson   Json                  @default("{}")
  /// Optional custom column layout for GENERIC_CSV / PaySpace / SimplePay / Xero
  customColumnsJson Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batches PayrollExportBatch[]

  @@index([companyId])
  @@index([companyId, isDefault])
}

model PayrollExportBatch {
  id                      String                   @id @default(cuid())
  companyId               String
  profileId               String
  periodKey               String // e.g. "2026-09" (26 Aug - 25 Sep)
  periodStart             DateTime                 @db.Date
  periodEnd               DateTime                 @db.Date
  status                  PayrollExportBatchStatus @default(DRAFT)
  employeeCount           Int                      @default(0)
  totalBasicHours         Decimal                  @default(0) @db.Decimal(12, 2)
  totalOvertimeHours      Decimal                  @default(0) @db.Decimal(12, 2)
  totalSundayHours        Decimal                  @default(0) @db.Decimal(12, 2)
  totalPublicHolidayHours Decimal                  @default(0) @db.Decimal(12, 2)
  totalNightShiftHours    Decimal                  @default(0) @db.Decimal(12, 2)
  totalPaidLeaveHours     Decimal                  @default(0) @db.Decimal(12, 2)
  totalUnpaidLeaveHours   Decimal                  @default(0) @db.Decimal(12, 2)
  readinessSnapshotJson   Json?
  overrideReason          String?                  @db.Text
  checksumSha256          String?
  lockedBy                String?
  lockedAt                DateTime?
  exportedBy              String?
  exportedAt              DateTime?
  voidedBy                String?
  voidedAt                DateTime?
  voidReason              String?                  @db.Text
  createdBy               String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profile       PayrollExportProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  lines         PayrollExportLine[]
  leaveRequests LeaveRequest[]

  @@index([companyId, periodKey])
  @@index([companyId, status])
}

model PayrollExportLine {
  id                  String   @id @default(cuid())
  batchId             String
  companyId           String
  employeeId          String
  externalPayrollCode String
  employeeFullName    String
  siteId              String?
  costCenterCode      String?
  basicHours          Decimal  @default(0) @db.Decimal(10, 2)
  overtimeHours       Decimal  @default(0) @db.Decimal(10, 2)
  sundayHours         Decimal  @default(0) @db.Decimal(10, 2)
  sundayDoubleHours   Decimal  @default(0) @db.Decimal(10, 2)
  publicHolidayHours  Decimal  @default(0) @db.Decimal(10, 2)
  nightShiftHours     Decimal  @default(0) @db.Decimal(10, 2)
  nightShiftCount     Int      @default(0)
  annualLeaveHours    Decimal  @default(0) @db.Decimal(10, 2)
  sickLeaveHours      Decimal  @default(0) @db.Decimal(10, 2)
  familyLeaveHours    Decimal  @default(0) @db.Decimal(10, 2)
  studyLeaveHours     Decimal  @default(0) @db.Decimal(10, 2)
  unpaidLeaveHours    Decimal  @default(0) @db.Decimal(10, 2)
  workedShiftsCount   Int      @default(0)
  sourceSummaryJson   Json?

  batch    PayrollExportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  site     Site?              @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([companyId, employeeId])
}