  guard   Employee @relation(fields: [guardId], references: [id], onDelete: Cascade)
  sitePost SitePost? @relation(fields: [sitePostId], references: [id], onDelete: SetNull)
  publishedShift Shift? @relation("RosterPublishedShift", fields: [publishedShiftId], references: [id], onDelete: SetNull)

  @@unique([siteId, guardId, rosterDate])
  @@index([companyId, siteId, rosterDate])
}

