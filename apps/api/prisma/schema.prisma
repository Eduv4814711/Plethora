  reviewed
  approved
}

/// Daily attendance for office staff (Employee.employeeType == "general").
///
/// Deliberately separate from SiteTimesheet/SiteTimesheetRow: office staff have no site,
/// no roster and no occurrence book, and they are paid a fixed monthly salary. Putting
/// them on a site timesheet would make `aggregateTimesheets` treat their hours as payable
/// on top of that salary, and would drag the mandatory Duty ON/OFF OB rules onto people
/// the occurrence book has nothing to do with.
///
/// This table is for leave cross-checks and reporting only. Nothing in payroll reads it.
model StaffAttendanceDay {
  id                    String                @id @default(cuid())
  companyId             String
  employeeId            String
  siteId                String?
  workDate              DateTime              @db.Date
  status                StaffAttendanceStatus
  timeIn                DateTime?
  timeOut               DateTime?
  /// Derived from timeIn/timeOut for display only — never read by payroll.
  hoursWorked           Decimal?              @db.Decimal(10, 2)
  clockInLat            Decimal?              @db.Decimal(10, 7)
  clockInLng            Decimal?              @db.Decimal(10, 7)
  clockOutLat           Decimal?              @db.Decimal(10, 7)
  clockOutLng           Decimal?              @db.Decimal(10, 7)
  clockInDistanceMeters Int?
  clockOutDistanceMeters Int?
  notes                 String?
  /// User.id of the supervisor who captured this, for the audit trail.
  recordedBy            String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  site     Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@unique([companyId, employeeId, workDate])
  @@index([companyId, workDate])
  @@index([employeeId, workDate])
  @@index([siteId])
}

enum StaffAttendanceStatus {
  present
  absent
  leave
  sick_leave
  public_holiday
  off
}

// --- Simple leave rebuild (4-table system) ---

enum LeaveType {
  ANNUAL
  SICK
  FAMILY_RESPONSIBILITY
  PARENTAL
  STUDY
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum FamilyResponsibilityReason {
  CHILD_BIRTH
  CHILD_SICK
  SPOUSE_OR_LIFE_PARTNER_DEATH
  PARENT_DEATH
  ADOPTIVE_PARENT_DEATH
  GRANDPARENT_DEATH
  CHILD_DEATH
  ADOPTED_CHILD_DEATH
  GRANDCHILD_DEATH
  SIBLING_DEATH
}

enum ParentalLeaveScenario {
  SOLE_OR_ONLY_EMPLOYED_PARENT
  SHARED_POOL
}

model LeaveRequest {
  id         String    @id @default(cuid())
  companyId  String
  employeeId String
  leaveType  LeaveType

  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  unitsRequested Decimal  @db.Decimal(5, 2)
  // Number of the employee's normal work units (days for general staff,
  // shifts for security officers) being taken. Entered directly by the
  // requester/manager, not derived from the date range — see README.

  status LeaveRequestStatus @default(PENDING)
  reason String? // free text; NOT used for FAMILY_RESPONSIBILITY

  familyResponsibilityReason FamilyResponsibilityReason? // only when leaveType = FAMILY_RESPONSIBILITY
  parentalLeaveScenario      ParentalLeaveScenario? // only when leaveType = PARENTAL
  workedPublicHoliday        Boolean                     @default(false) // flag only, no pay calculation here

  reviewedBy     String?
  reviewedAt     DateTime?
  decisionReason String?

  payrollExportBatchId String? // set when an approved export batch consumes this leave; cleared on batch void

  retentionUntil DateTime // POPIA: 3 years after last entry. Stored only, no automated deletion yet.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company             Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee            Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollExportBatch  PayrollExportBatch?       @relation(fields: [payrollExportBatchId], references: [id], onDelete: SetNull)
  medicalCertificate  MedicalCertificate?
  supportingDocuments LeaveSupportingDocument[]

  @@index([companyId, employeeId, leaveType])
  @@index([companyId, status])
  @@index([payrollExportBatchId])
}

enum LeaveDocumentKind {
  SICK_NOTE
  STUDY_PROOF
  FAMILY_RESPONSIBILITY_PROOF
  PARENTAL_PROOF
  OTHER
}

model LeaveSupportingDocument {
  id             String            @id @default(cuid())
  companyId      String
  leaveRequestId String
  kind           LeaveDocumentKind
  fileName       String
  mimeType       String
  fileReference  String
  uploadedBy     String
  createdAt      DateTime          @default(now())

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@index([companyId, leaveRequestId])
}

model MedicalCertificate {
  id                             String   @id @default(cuid())
  leaveRequestId                 String   @unique
  practitionerName               String
  practitionerRegistrationNumber String
  consultationDate               DateTime @db.Date
  bookedOffStartDate             DateTime @db.Date
  bookedOffEndDate               DateTime @db.Date
  fileReference                  String // pointer into existing file storage
  // No diagnosis field. Not optional, not nullable. Must never be added here.
  createdAt                      DateTime @default(now())

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
}

model LeaveAdjustment {
  id         String    @id @default(cuid())
  companyId  String
  employeeId String
  leaveType  LeaveType
  units      Decimal   @db.Decimal(5, 2) // signed: positive = grant extra, negative = deduct
  reason     String
  createdBy  String
  createdAt  DateTime  @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, leaveType])
}

model LeaveAuditLog {
  id          String   @id @default(cuid())
  companyId   String
  employeeId  String?
  actorUserId String
  action      String // "REQUEST_CREATED" | "REQUEST_APPROVED" | "REQUEST_REJECTED" | "REQUEST_CANCELLED" | "BALANCE_ADJUSTED"
  entityType  String // "leave_request" | "leave_adjustment"
  entityId    String
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime @default(now())
  // Append-only: application code never updates or deletes rows here.

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@index([entityType, entityId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  companyId  String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  /// "success" | "denied" | "failure". Denied rows record refused access attempts.
  outcome    String   @default("success")
  /// Request forensics, so an audit row can be correlated with the server logs.
  ipAddress  String?
  userAgent  String?
  requestId  String?
  /// Set when the actor could not be resolved to a User row (e.g. a failed login).
  actorLabel String?
  timestamp  DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, timestamp])
  @@index([companyId, entityType, entityId])
  @@index([companyId, action, timestamp])
  @@index([companyId, userId, timestamp])
  @@index([companyId, outcome, timestamp])
  @@index([entityType])
  @@index([entityId])
  @@index([timestamp])
}

model WhatsAppMessage {
  id                String   @id @default(cuid())
  companyId         String
  employeeId        String
  whatsappMessageId String?
  direction         String // "inbound" | "outbound"
  type              String   @default("text")
  text              String?  @db.Text
  status            String?
  sentByUserId      String?
  createdAt         DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, createdAt])
  @@index([whatsappMessageId])
}

/// Pending WhatsApp clock-in/out when site geofence requires a follow-up location message.
model WhatsAppClockPending {
  id             String   @id @default(cuid())
  waFrom         String   @unique
  employeeId     String
  companyId      String
  intent         String // clock_in | clock_out | office_clock_in | office_clock_out
  shiftId        String?
  siteId         String?
  failedAttempts Int      @default(0)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([employeeId])
}

/// Durable record of received Meta WhatsApp webhook events for reliable idempotency and auditing.
model WhatsAppWebhookEvent {
  id            String    @id @default(cuid())
  metaEventId   String    @unique
  phoneNumberId String?
  eventType     String
  payload       Json?
  status        String // "PROCESSING" | "PROCESSED" | "FAILED"
  errorMessage  String?
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?

  @@index([receivedAt])
}

