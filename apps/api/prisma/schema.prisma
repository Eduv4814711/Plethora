  channel      NotificationChannel @default(IN_APP)
  status       NotificationStatus  @default(PENDING)
  /// Deduplication key to avoid spam
  dedupeKey    String?
  sourceModule String?
  sourceId     String?
  linkUrl      String?
  metadata     Json?
  sentAt       DateTime?
  readAt       DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, dedupeKey])
  @@index([userId, status])
  @@index([companyId, createdAt])
}

model Client {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  phone     String?
  userId    String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Billing contact — falls back to `email` when null.
  billingEmail       String?
  billingAddress     String? @db.Text
  vatNumber          String?
  registrationNumber String?
  /// Days added to the invoice date to derive the due date.
  paymentTermsDays   Int     @default(30)

  /// Day-to-day operational contact at the client.
  contactPersonName   String?
  contactPersonRole   String?
  contactPersonMobile String?
  /// Client head office. Site addresses live on Site.physicalAddress.
  physicalAddress     String?  @db.Text
  notes               String?  @db.Text
  /// Who the month-end pack is emailed to (manually). Empty falls back to `billingEmail ?? email`.
  reportRecipients    String[] @default([])

  /// Legal identity & corporate classification (Phase 1 upgrade)
  legalName             String?
  tradingName           String?
  entityType            ClientEntityType?
  taxNumber             String?
  registeredAddress     String?                @db.Text
  onboardingStatus      ClientOnboardingStatus @default(DRAFT)
  onboardingCompletedAt DateTime?

  company               Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                  User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  sites                 Site[]
  managedDocuments      ManagedDocument[]
  quotes                ClientQuote[]
  invoices              ClientInvoice[]
  payments              ClientPayment[]
  billingRates          SiteBillingRate[]
  billingConfigs        SiteBillingConfig[]
  contacts              ClientContact[]
  relatedParties        ClientRelatedParty[]
  contracts             ClientContract[]
  dataProcessingProfile ClientDataProcessingProfile?

  @@index([companyId])
  @@index([userId])
}

