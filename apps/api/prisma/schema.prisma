// Plethora - Security Workforce Operations & Compliance ERP
// Multi-tenant ready schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Company {
  id   String @id @default(cuid())
  name String

  // The database also carries `Company_owner_same_company_fkey`, a composite foreign key on
  // ("id", "ownerUserId") -> User("companyId", "id") added in 20260723120000_capability_access.
  // It stops a company being owned by a user from a different tenant. Prisma's schema language
  // cannot express a composite foreign key, so `prisma migrate diff` always reports it as drift
  // and `prisma migrate dev` will offer to DROP it. Never accept that — keep the constraint and
  // ignore this one expected diff entry.
  ownerUserId String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Business details
  legalName          String?
  registrationNumber String?
  taxNumber          String?
  /// SA VAT registration number — legally distinct from taxNumber (income tax ref).
  vatNumber          String?
  address            String?
  phone              String?
  email              String?
  logoUrl            String?
  website            String?
  fax                String?
  psiraRegistration  String?
  uifReference       String?
  payeReference      String? // External Sage / SARS employer PAYE ref
  sdlReference       String? // External Sage / SARS employer SDL ref

  // Business settings & theme (JSON for flexibility)
  settings Json? // { currency, dateFormat, timezone, payrollPeriod, etc. }
  theme    Json? // { primaryColor, accentColor, mode: "light"|"dark"|"system" }

  users                 User[]                 @relation("CompanyUsers")
  owner                 User?                  @relation("CompanyOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  employees             Employee[]
  sites                 Site[]
  whatsAppClockPendings WhatsAppClockPending[]
  shifts                Shift[]
  auditLogs             AuditLog[]
  rosterAutomationRuns  RosterAutomationRun[]
  employeeGroups        EmployeeGroup[]
  publicHolidays        PublicHoliday[]
  whatsappMessages      WhatsAppMessage[]

  siteRosterPatterns        SiteRosterPattern[]
  siteRosterManualOverrides SiteRosterManualOverride[]
  siteRosterGeneratedShifts SiteRosterGeneratedShift[]
  siteTimesheets            SiteTimesheet[]
  siteTimesheetRows         SiteTimesheetRow[]
  staffAttendanceDays       StaffAttendanceDay[]
  siteBillingRates          SiteBillingRate[]
  siteBillingConfigs        SiteBillingConfig[]

  leaveRequests    LeaveRequest[]
  leaveAdjustments LeaveAdjustment[]
  leaveAuditLogs   LeaveAuditLog[]

  // Operational modules
  operationalAlerts            OperationalAlert[]
  attendanceExceptions         AttendanceException[]
  managedDocuments             ManagedDocument[]
  documentVersions             DocumentVersion[]
  incidents                    Incident[]
  approvalRequests             ApprovalRequest[]
  appNotifications             AppNotification[]
  clients                      Client[]
  clientQuotes                 ClientQuote[]
  clientInvoices               ClientInvoice[]
  clientPayments               ClientPayment[]
  clientReceipts               ClientReceipt[]
  clientContacts               ClientContact[]
  clientRelatedParties         ClientRelatedParty[]
  clientContracts              ClientContract[]
  clientContractSites          ClientContractSite[]
  clientDataProcessingProfiles ClientDataProcessingProfile[]
  accessChangeRequests         AccessChangeRequest[]

  // External Payroll Export (Sage / Generic adapters)
  payrollExportProfiles PayrollExportProfile[]
  payrollExportBatches  PayrollExportBatch[]

  // Operational Compliance & Legal Register
  complianceObligations      ComplianceObligation[]
  complianceRemediationPlans ComplianceRemediationPlan[]
  complianceLegalCases       ComplianceLegalCase[]
  employmentExits            EmploymentExit[]
  leaveSupportingDocuments   LeaveSupportingDocument[]
}

model User {
  id                           String      @id @default(cuid())
  companyId                    String
  name                         String
  email                        String      @unique
  passwordHash                 String
  passwordSetupRequired        Boolean     @default(false)
  passwordSetupTokenHash       String?
  passwordSetupTokenExpiresAt  DateTime?
  passwordSetupTokenConsumedAt DateTime?
  accountType                  AccountType @default(staff)
  jobTitle                     String?
  isActive                     Boolean     @default(true)
  /// Explicit path-to-capability map. Missing capabilities are denied. The company owner bypasses this map.
  capabilities                 Json        @default("{}")
  createdAt                    DateTime    @default(now())
  updatedAt                    DateTime    @updatedAt

  company       Company        @relation("CompanyUsers", fields: [companyId], references: [id], onDelete: Cascade)
  ownedCompany  Company?       @relation("CompanyOwner")
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]

  // Operational relations
  supervisedSites         Site[]                @relation("SiteSupervisor")
  alertsAssigned          OperationalAlert[]    @relation("AlertAssignedTo")
  alertsResolved          OperationalAlert[]    @relation("AlertResolvedBy")
  exceptionsReviewed      AttendanceException[] @relation("ExceptionReviewedBy")
  documentsUploaded       ManagedDocument[]     @relation("DocumentUploadedBy")
  documentsVerified       ManagedDocument[]     @relation("DocumentVerifiedBy")
  documentVersionsCreated DocumentVersion[]     @relation("DocumentVersionCreatedBy")
  incidentsReported       Incident[]            @relation("IncidentReportedBy")
  incidentsSupervised     Incident[]            @relation("IncidentAssignedSupervisor")
  approvalsRequested      ApprovalRequest[]     @relation("ApprovalRequestedBy")
  approvalsToReview       ApprovalRequest[]     @relation("ApprovalApprover")
  notificationsReceived   AppNotification[]
  clientProfile           Client?

  // Operational Compliance & Legal Register + Client Billing
  obligationsOwned        ComplianceObligation[]      @relation("ObligationOwner")
  obligationsVerified     ComplianceObligation[]      @relation("ObligationVerifiedBy")
  obligationsOverridden   ComplianceObligation[]      @relation("ObligationManagementOverride")
  remediationPlansOwned   ComplianceRemediationPlan[] @relation("RemediationPlanOwner")
  legalCasesAssigned      ComplianceLegalCase[]       @relation("LegalCaseAssignedTo")
  employmentExitsProcessed EmploymentExit[]           @relation("EmploymentExitProcessedBy")
  clientQuotesDecided     ClientQuote[]               @relation("ClientQuoteDecidedBy")
  clientPaymentsRecorded  ClientPayment[]             @relation("ClientPaymentRecordedBy")
  clientReceiptsIssued    ClientReceipt[]             @relation("ClientReceiptIssuedBy")
  siteBillingRatesCreated SiteBillingRate[]           @relation("SiteBillingRateCreatedBy")

  // Access change requests (maker-checker on user access)
  accessChangesTargeting AccessChangeRequest[] @relation("AccessChangeTarget")
  accessChangesRequested AccessChangeRequest[] @relation("AccessChangeRequestedBy")
  accessChangesReviewed  AccessChangeRequest[] @relation("AccessChangeReviewedBy")

  @@unique([companyId, id])
  @@index([companyId])
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  replacedByTokenId String?
  userAgent         String?
  ipAddress         String?

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces   RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

enum AccountType {
  staff
  client
}

model Employee {
  id                  String         @id @default(cuid())
  companyId           String
  employeeNumber      String         @default(cuid()) // Unique per company - auto-generated for existing rows, can be set on create
  externalPayrollCode String?        // External payroll identifier (e.g. Sage employee code)
  firstName           String
  lastName            String
  idNumber            String?
  phone               String?
  status              EmployeeStatus
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Employee type: general (Labour Law) vs security_officer (PSIRA/NBCPSS)
  employeeType String  @default("security_officer") // "general" | "security_officer"
  jobRole      String? // e.g. "Security Officer", "HR Manager"

  // Labour Law (BCEA) & HR Master Data (exported to external payroll on onboarding)
  dateOfBirth       DateTime?
  gender            String? // M/F
  maritalStatus     String? // single, married, divorced, widowed
  email             String?
  physicalAddress   String?
  postalAddress     String?
  postalCode        String?
  taxNumber         String?
  bankName          String?
  bankAccountNumber String?
  bankBranchCode    String?
  commencementDate  DateTime?
  occupation        String?
  placeOfWork       String?
  geofenceExempt    Boolean   @default(false)
  ordinaryHours     String? // e.g. "45 hours/week"
  ordinaryDays      String? // e.g. "Mon-Fri"
  leaveEntitlement  String?
  noticePeriod      String?
  previousService   String?

  // Simple leave rebuild: only needs a value if the 36-month sick-leave
  // cycle should start on a different date than commencementDate (e.g.
  // re-employment after a break in service). Defaults to commencementDate
  // in application code when null.
  sickLeaveCycleAnchor DateTime?

  // PSIRA - security staff
  psiraRegistrationNumber String?
  psiraRegistrationExpiry DateTime?
  psiraGrade              String? // "E" | "D" | "C" | "B" | "A"
  securityServiceType     String? // guarding, patrolling, close_protection, etc.
  nextOfKin1Name          String?
  nextOfKin1Phone         String?
  nextOfKin2Name          String?
  nextOfKin2Phone         String?
  nextOfKin3Name          String?
  nextOfKin3Phone         String?
  residedOutsideSA        Boolean?
  militaryPoliceService   Boolean?
  criminalInvestigation   Boolean?
  mentallyUnstable        Boolean?
  trainingCompleted       Boolean?
  firearmCompetency       Boolean   @default(false)
  firearmCompetencyExpiry DateTime?
  armedGuard              Boolean   @default(false)
  bceaSectorOverride      String?
  preferredShiftType      String?

  groupId                   String?
  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group                     EmployeeGroup?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  shifts                    Shift[]
  siteAssignments           SiteAssignment[]
  guardSiteEligibilities    GuardSiteEligibility[]
  siteRosterPatternCells    SiteRosterPatternCell[]
  siteRosterManualOverrides SiteRosterManualOverride[]
  siteRosterGeneratedShifts SiteRosterGeneratedShift[]
  plannedSiteTimesheetRows  SiteTimesheetRow[]         @relation("PlannedTimesheetGuard")
  actualSiteTimesheetRows   SiteTimesheetRow[]         @relation("ActualTimesheetGuard")
  whatsappMessages          WhatsAppMessage[]
  whatsAppClockPendings     WhatsAppClockPending[]
  attendanceExceptions      AttendanceException[]
  managedDocuments          ManagedDocument[]
  operationalAlerts         OperationalAlert[]
  leaveRequests             LeaveRequest[]
  leaveAdjustments          LeaveAdjustment[]
  staffAttendanceDays       StaffAttendanceDay[]
  payrollExportLines        PayrollExportLine[]
  complianceLegalCases      ComplianceLegalCase[]
  employmentExits           EmploymentExit[]

  @@unique([companyId, employeeNumber])
  @@unique([companyId, externalPayrollCode])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, employeeType])
  @@index([companyId, groupId])
  @@index([groupId])
  @@index([status])
  @@index([employeeType])
}

enum EmployeeStatus {
  applicant
  hired
  training
  active
  reliever
  suspended
  offboarded
}

model Site {
  id                             String                @id @default(cuid())
  companyId                      String
  name                           String
  location                       String? // Legacy/short name
  costCenterCode                 String? // External payroll department / cost centre code (e.g. Sage)
  physicalAddress                String? // Full physical address
  contactPersonName              String?
  contactPersonPhone             String?
  /// Extended client contact (email) — complements contactPersonName/Phone
  clientContactEmail             String?
  contractOrServiceAgreement     String? // Contract reference or description
  contractStartDate              DateTime?
  contractEndDate                DateTime?
  serviceType                    String? // guarding, access_control, patrols, etc.
  /// Deprecated: Operational pricing has migrated to SiteBillingRate managed in Client Billing.
  monthlyRevenue                 Decimal?              @db.Decimal(12, 2)
  /// Site supervisor assignment; job titles never authorize access.
  supervisorId                   String?
  riskLevel                      SiteRiskLevel         @default(LOW)
  siteStatus                     SiteOperationalStatus @default(ACTIVE)
  siteInstructions               String?               @db.Text
  clientId                       String?
  /// Geofence center (WGS84). All three geofence fields must be set to enforce clock-in location on WhatsApp.
  latitude                       Decimal?              @db.Decimal(10, 7)
  longitude                      Decimal?              @db.Decimal(10, 7)
  geofenceRadiusMeters           Int?
  /// Shown on the shift roster sheet / PDF under “Site rules” (e.g. gender mix per shift).
  rosterSiteRules                String?               @db.Text
  rosterDayShiftGender           String? // male | female | any — roster display only
  rosterNightShiftGender         String? // male | female | any
  /// Minimum guards rostered on each day / night shift (auto-roster and coverage checks).
  rosterDayShiftGuardsRequired   Int                   @default(1)
  rosterNightShiftGuardsRequired Int                   @default(1)
  /// Weekdays each shift needs cover, as JS day-of-week numbers (0=Sunday … 6=Saturday).
  /// Not every site needs 7-day cover; days left out produce no roster demand and no coverage-gap alerts.
  rosterDayShiftDays             Int[]                 @default([0, 1, 2, 3, 4, 5, 6])
  rosterNightShiftDays           Int[]                 @default([0, 1, 2, 3, 4, 5, 6])
  /// Site-level shift operating hours (defaults: Day 06:00-18:00, Night 18:00-06:00)
  rosterDayShiftStartTime        String?               @default("06:00")
  rosterDayShiftEndTime          String?               @default("18:00")
  rosterNightShiftStartTime      String?               @default("18:00")
  rosterNightShiftEndTime        String?               @default("06:00")
  /// Extra lines on the shift roster sheet / PDF (operational notes).
  rosterSheetNotes               String?               @db.Text
  rosterDayShiftGenderMode       String?
  rosterNightShiftGenderMode     String?
  rosterDayShiftCustomMales      Int?
  rosterDayShiftCustomFemales    Int?
  rosterNightShiftCustomMales    Int?
  rosterNightShiftCustomFemales  Int?
  dayShiftEnabled                Boolean               @default(true)
  nightShiftEnabled              Boolean               @default(true)
  /// Automatic roster generation from cycle calendar.
  autoRosterEnabled              Boolean               @default(false)
  autoRosterMinCoveragePercent   Int                   @default(100)
  autoRosterLastRunAt            DateTime?
  autoRosterLastStatus           String?
  /// Site-specific roster calendar and continuous-pattern automation state.
  rosterPeriodCalendarId         String?
  rosterContinuityState          RosterContinuityState @default(not_setup)
  rosterMaintainedThrough        DateTime?             @db.Date
  rosterLastReconciledAt         DateTime?
  rosterLastReconciliationStatus String?
  rosterContinuityPauseReason    String?               @db.Text
  /// SA Labour, Occurrence Book, Meal Interval & Rostering Framework defaults (nullable = inherit company settings)
  obBookMode                     String?
  psiraEnforcementMode           String?
  operatingFramework             String?
  mealIntervalPaid               Boolean               @default(true)
  mealIntervalMinutes            Int                   @default(60)
  createdAt                      DateTime              @default(now())
  updatedAt                      DateTime              @updatedAt

  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supervisor                User?                      @relation("SiteSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  client                    Client?                    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  quotes                    ClientQuote[]              @relation("ClientQuoteSite")
  quoteLines                ClientQuoteLine[]          @relation("ClientQuoteLineSite")
  invoices                  ClientInvoice[]            @relation("ClientInvoiceSite")
  invoiceLines              ClientInvoiceLine[]        @relation("ClientInvoiceLineSite")
  billingRates              SiteBillingRate[]
  billingConfig             SiteBillingConfig?
  contractSites             ClientContractSite[]
  posts                     SitePost[]
  assignedGuards            SiteAssignment[]
  guardSiteEligibilities    GuardSiteEligibility[]
  coverageRequirements      CoverageRequirement[]
  rosterAutomationRuns      RosterAutomationRun[]
  shifts                    Shift[]
  siteRosterPatterns        SiteRosterPattern[]
  siteRosterManualOverrides SiteRosterManualOverride[]
  siteRosterGeneratedShifts SiteRosterGeneratedShift[]
  siteTimesheets            SiteTimesheet[]
  siteTimesheetRows         SiteTimesheetRow[]
  operationalAlerts         OperationalAlert[]
  attendanceExceptions      AttendanceException[]
  managedDocuments          ManagedDocument[]
  incidents                 Incident[]
  payrollExportLines        PayrollExportLine[]
  employmentExits           EmploymentExit[]           @relation("EmploymentExitSite")
  newEmploymentExits        EmploymentExit[]           @relation("EmploymentExitNewSite")
  staffAttendanceDays       StaffAttendanceDay[]

  @@index([companyId])
  @@index([companyId, siteStatus])
  @@index([companyId, rosterContinuityState], map: "Site_rosterContinuityState_idx")
  @@index([supervisorId])
  @@index([clientId])
  @@index([contractEndDate])
  @@index([riskLevel])
}

model RosterAutomationRun {
  id              String    @id @default(cuid())
  companyId       String
  siteId          String
  periodStart     DateTime
  periodEnd       DateTime
  status          String
  coveragePercent Int?
  planSnapshot    Json?
  warnings        Json?
  errorMessage    String?
  appliedAt       DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([siteId, createdAt])
}

model SiteAssignment {
  id             String                  @id @default(cuid())
  siteId         String
  employeeId     String
  assignedAt     DateTime                @default(now())
  assignmentType SiteGuardAssignmentType @default(PERMANENT)
  priority       Int                     @default(0)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  isActive       Boolean                 @default(true)

  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([siteId, employeeId])
  @@index([siteId])
  @@index([employeeId])
}

enum SiteGuardAssignmentType {
  PERMANENT
  RELIEVER
  TEMPORARY
}

model SitePost {
  id                     String   @id @default(cuid())
  siteId                 String
  name                   String
  sortOrder              Int      @default(0)
  isActive               Boolean  @default(true)
  requiredPsiraGrade     String?
  requiresFirearm        Boolean  @default(false)
  requiredGender         String?
  shiftPatternPreference String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  site                      Site                       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  guardEligibilities        GuardSiteEligibility[]
  coverageRequirements      CoverageRequirement[]
  siteRosterPatternCells    SiteRosterPatternCell[]
  siteRosterGeneratedShifts SiteRosterGeneratedShift[]

  @@index([siteId])
  @@map("SitePost")
}

model GuardSiteEligibility {
  id         String   @id @default(cuid())
  siteId     String
  employeeId String
  sitePostId String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sitePost SitePost @relation(fields: [sitePostId], references: [id], onDelete: Cascade)

  @@unique([siteId, employeeId, sitePostId])
  @@index([siteId])
  @@index([sitePostId])
  @@index([employeeId])
}

model CoverageRequirement {
  id             String   @id @default(cuid())
  siteId         String
  sitePostId     String
  shiftTypeCode  String
  guardsRequired Int      @default(1)
  genderRule     String   @default("any")
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sitePost SitePost @relation(fields: [sitePostId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([sitePostId])
}

model Shift {
  id             String      @id @default(cuid())
  companyId      String
  employeeId     String
  siteId         String
  shiftType      String? // day | night
  legacyPostName String?
  startTime      DateTime
  endTime        DateTime
  status         ShiftStatus
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company               Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee              Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  site                  Site                      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  attendances           Attendance[]
  rosterGeneratedSource SiteRosterGeneratedShift? @relation("RosterPublishedShift")

  @@index([companyId])
  @@index([companyId, startTime])
  @@index([companyId, employeeId, startTime])
  @@index([companyId, siteId, startTime])
  @@index([companyId, status, startTime])
  @@index([employeeId])
  @@index([siteId])
  @@index([startTime])
  @@index([status])
}

enum ShiftStatus {
  created
  assigned
  active
  completed
  verified
}

model Attendance {
  id            String    @id @default(cuid())
  shiftId       String
  clockIn       DateTime?
  clockOut      DateTime?
  clockInLat    Decimal?  @db.Decimal(10, 7)
  clockInLng    Decimal?  @db.Decimal(10, 7)
  clockOutLat   Decimal?  @db.Decimal(10, 7)
  clockOutLng   Decimal?  @db.Decimal(10, 7)
  hoursWorked   Decimal?  @db.Decimal(10, 2)
  overtimeHours Decimal?  @db.Decimal(10, 2)
  status               String    @default("pending")
  source               String    @default("clock_in") // "clock_in" | "manual"
  submissionLat        Float?
  submissionLon        Float?
  distanceMeters       Int?
  geofenceRadiusMeters Int?
  withinGeofence       Boolean   @default(false)
  validationStatus     String    @default("VERIFIED") // States: VERIFIED, REJECTED_GEOFENCE, FLAGGED_NO_GEOFENCE, MANUAL_OVERRIDE
  whatsappMessageId    String?   // Link to wamid
  whatsappNumber       String?
  rejectionReason      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId])
  @@index([shiftId])
}

model EmployeeGroup {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@index([companyId])
}

model PublicHoliday {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime @db.Date
  name      String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId])
}

model SiteTimesheet {
  id            String              @id @default(cuid())
  companyId     String
  siteId        String
  periodStart   DateTime            @db.Date
  periodEnd     DateTime            @db.Date
  status        SiteTimesheetStatus @default(draft)
  reviewedBy    String?
  reviewedAt    DateTime?
  approvedBy    String?
  approvedAt    DateTime?
  unlockedBy    String?
  unlockedAt    DateTime?
  unlockReason  String?
  approvalNotes String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  rows    SiteTimesheetRow[]

  @@unique([companyId, siteId, periodStart, periodEnd])
  @@index([companyId, status])
  @@index([siteId, periodStart, periodEnd])
}

model SiteTimesheetRow {
  id                   String                  @id @default(cuid())
  companyId            String
  siteTimesheetId      String
  siteId               String
  workDate             DateTime                @db.Date
  plannedGuardId       String?
  actualGuardId        String?
  plannedShiftCode     String?
  plannedShiftType     String?
  actualShiftCode      String?
  actualShiftType      String?
  clockIn              DateTime?
  clockOut             DateTime?
  hoursWorked          Decimal?                @db.Decimal(10, 2)
  overtimeHours        Decimal?                @db.Decimal(10, 2)
  attendanceStatus     SiteTimesheetAttendance @default(pending)
  approvalStatus       SiteTimesheetRowStatus  @default(pending)
  /// Duty ON occurrence book number (start of shift).
  dutyOnObNumber       String?
  /// Duty OFF occurrence book number (end of shift).
  dutyOffObNumber      String?
  /// Deprecated: mirrored from dutyOnObNumber for backward compatibility.
  occurrenceBookNumber String?
  comments             String?
  discrepancyCodes     Json?
  sundayDoubleHours    Decimal                 @default(0) @db.Decimal(8, 2)
  nightShiftCount      Int                     @default(0)
  complianceFlags      Json?
  sourceShiftId        String?
  sourceAttendanceId   String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  siteTimesheet SiteTimesheet @relation(fields: [siteTimesheetId], references: [id], onDelete: Cascade)
  site          Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  plannedGuard  Employee?     @relation("PlannedTimesheetGuard", fields: [plannedGuardId], references: [id], onDelete: SetNull)
  actualGuard   Employee?     @relation("ActualTimesheetGuard", fields: [actualGuardId], references: [id], onDelete: SetNull)

  /// One planned roster cell per timesheet (guard + date + shift). Reliever rows omit plannedGuardId.
  @@unique([siteTimesheetId, workDate, plannedGuardId, plannedShiftType])
  @@index([companyId, workDate])
  @@index([companyId, actualGuardId, workDate])
  @@index([siteTimesheetId, workDate])
  @@index([siteId, workDate])
}

enum SiteTimesheetStatus {
  draft
  approved
  locked
}

enum SiteTimesheetAttendance {
  pending
  present
  absent
  late
  left_early
  reliever
  shift_swapped
  leave
  sick_leave
  training
  off
}

enum SiteTimesheetRowStatus {
