model Incident {
  id                       String                    @id @default(cuid())
  companyId                String
  incidentNumber           String
  siteId                   String
  reportedById             String
  assignedSupervisorId     String?
  incidentDateTime         DateTime
  incidentType             IncidentType
  severity                 IncidentSeverity
  title                    String
  description              String                    @db.Text
  peopleInvolved           String?                   @db.Text
  witnesses                String?                   @db.Text
  clientVisible            Boolean                   @default(false)
  status                   IncidentStatus            @default(DRAFT)
  supervisorApprovalStatus SupervisorApprovalStatus  @default(PENDING)
  supervisorNote           String?
  followUpRequired         Boolean                   @default(false)
  followUpTaskId           String?
