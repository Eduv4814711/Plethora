  enrolments      Enrolment[]
  academyInvoices AcademyInvoice[]
  academyPayments AcademyPayment[]
  academyAssessments AcademyAssessment[]
  academyCertificates AcademyCertificate[]

  @@unique([companyId, studentNumber])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([employeeId])
  @@index([status])
