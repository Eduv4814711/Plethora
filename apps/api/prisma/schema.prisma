enum SiteRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SiteOperationalStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum AlertPriority {
  CRITICAL
  MEDIUM
  LOW
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum AlertSourceModule {
  DASHBOARD
  ATTENDANCE
  ROSTERING
  PAYROLL
  TASKS
  SITES
  DOCUMENTS
  INCIDENTS
  REPORTS
  WHATSAPP
  APPROVALS
}

model OperationalAlert {
  id             String            @id @default(cuid())
  companyId      String
  title          String
  message        String
  priority       AlertPriority
  status         AlertStatus       @default(OPEN)
  sourceModule   AlertSourceModule
  /// Deduplication key e.g. "missed_clock_in:shiftId:abc"
  dedupeKey      String?
  sourceId       String?
  assignedToId   String?
  siteId         String?
  employeeId     String?
  metadata       Json?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo User?     @relation("AlertAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy User?     @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  site       Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([companyId, dedupeKey])
  @@index([companyId, status, priority])
  @@index([companyId, sourceModule])
  @@index([siteId])
  @@index([assignedToId])
  @@index([createdAt])
}

enum AttendanceExceptionType {
  LATE_ARRIVAL
  EARLY_DEPARTURE
  MISSED_CLOCK_IN
  MISSED_CLOCK_OUT
  ABSENT
  OUTSIDE_GEOFENCE
  UNSCHEDULED_CLOCK_IN
  PENDING_SUPERVISOR_REVIEW
  MANUAL_ADJUSTMENT_REQUIRED
  SHIFT_NOT_FOUND
  DUPLICATE_CLOCK_EVENT
}

enum ExceptionSeverity {
  CRITICAL
  MEDIUM
  LOW
}

enum ExceptionReviewStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESOLVED
}

model AttendanceException {
  id            String                  @id @default(cuid())
  companyId     String
  attendanceId  String?
  shiftId       String?
  employeeId    String?
  siteId        String?
  exceptionType AttendanceExceptionType
  severity      ExceptionSeverity
  description   String
  minutesLate   Int?
  minutesEarly  Int?
  detectedAt    DateTime                @default(now())
  status        ExceptionReviewStatus   @default(OPEN)
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  /// Deduplication key e.g. "MISSED_CLOCK_IN:shift:abc"
  dedupeKey     String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  site       Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  reviewedBy User?     @relation("ExceptionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([companyId, dedupeKey])
  @@index([companyId, status, severity])
  @@index([companyId, exceptionType])
  @@index([siteId])
  @@index([employeeId])
  @@index([shiftId])
  @@index([detectedAt])
}

enum DocumentCategory {
  EMPLOYEE
  SITE
  CLIENT
  PAYROLL
  ATTENDANCE
  INCIDENT
  EQUIPMENT
  COMPLIANCE
  TASK
  OTHER
