model SiteTimesheet {
  id              String              @id @default(cuid())
  companyId       String
  siteId          String
  periodStart     DateTime            @db.Date
  periodEnd       DateTime            @db.Date
  status          SiteTimesheetStatus  @default(draft)
  reviewedBy      String?
  reviewedAt      DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  unlockedBy      String?
  unlockedAt      DateTime?
  unlockReason    String?
  approvalNotes   String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  rows    SiteTimesheetRow[]

  @@unique([companyId, siteId, periodStart, periodEnd])
  @@index([companyId, status])
  @@index([siteId, periodStart, periodEnd])
}

model SiteTimesheetRow {
  id                    String                  @id @default(cuid())
  companyId             String
  siteTimesheetId       String
  siteId                String
  workDate              DateTime                @db.Date
  plannedGuardId        String?
  actualGuardId         String?
  plannedShiftCode      String?
  plannedShiftType      String?
  actualShiftCode       String?
  actualShiftType       String?
  clockIn               DateTime?
  clockOut              DateTime?
  hoursWorked           Decimal?                @db.Decimal(10, 2)
  overtimeHours         Decimal?                @db.Decimal(10, 2)
  attendanceStatus      SiteTimesheetAttendance @default(pending)
  approvalStatus        SiteTimesheetRowStatus  @default(pending)
  /// Duty ON occurrence book number (start of shift).
  dutyOnObNumber        String?
  /// Duty OFF occurrence book number (end of shift).
  dutyOffObNumber       String?
  /// Deprecated: mirrored from dutyOnObNumber for backward compatibility.
  occurrenceBookNumber  String?
  comments              String?
  discrepancyCodes      Json?
  sourceShiftId         String?
  sourceAttendanceId    String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  siteTimesheet SiteTimesheet @relation(fields: [siteTimesheetId], references: [id], onDelete: Cascade)
  site          Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  plannedGuard  Employee?     @relation("PlannedTimesheetGuard", fields: [plannedGuardId], references: [id], onDelete: SetNull)
  actualGuard   Employee?     @relation("ActualTimesheetGuard", fields: [actualGuardId], references: [id], onDelete: SetNull)

  /// One planned roster cell per timesheet (guard + date + shift). Reliever rows omit plannedGuardId.
  @@unique([siteTimesheetId, workDate, plannedGuardId, plannedShiftType])
  @@index([companyId, workDate])
  @@index([companyId, actualGuardId, workDate])
  @@index([siteTimesheetId, workDate])
  @@index([siteId, workDate])
}

enum SiteTimesheetStatus {
  draft
  approved
  locked
}

enum SiteTimesheetAttendance {
  pending
  present
  absent
  late
  left_early
  reliever
  shift_swapped
  leave
  sick_leave
  training
  off
}

enum SiteTimesheetRowStatus {
  pending
  partially_reviewed
  reviewed
  approved
}

