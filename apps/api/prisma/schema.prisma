  active
  archived
}

enum RosterContinuityState {
  not_setup
  running
  needs_attention
  paused
}

enum SiteRosterGeneratedSource {
  pattern
  manual_override
  leave
  replacement
  legacy
}

enum SiteRosterShiftCode {
  D
  N
  O
  L
  SL
  TR
  SB
  AWOL
  R
  blank
}

enum SiteRosterShiftType {
  day
  night
  off
  leave
  sick_leave
  training
  standby
  awol
  replaced
  unassigned
}

model SiteRosterPattern {
  id              String                  @id @default(cuid())
  companyId       String
  siteId          String
  name            String
  anchorDate      DateTime                @db.Date
  cycleLengthDays Int
  effectiveFrom   DateTime                @db.Date
  effectiveTo     DateTime?               @db.Date
  status          SiteRosterPatternStatus @default(draft)
  createdBy       String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  cells   SiteRosterPatternCell[]

  @@index([companyId, siteId, status])
  @@index([siteId, effectiveFrom])
}

model SiteRosterPatternCell {
  id              String              @id @default(cuid())
  rosterPatternId String
  guardId         String
  patternDayIndex Int
  shiftCode       SiteRosterShiftCode @default(blank)
  shiftType       SiteRosterShiftType @default(unassigned)
  sitePostId      String?
  isLocked        Boolean             @default(false)
  notes           String?

  pattern SiteRosterPattern @relation(fields: [rosterPatternId], references: [id], onDelete: Cascade)
  guard   Employee          @relation(fields: [guardId], references: [id], onDelete: Cascade)
  sitePost SitePost?        @relation(fields: [sitePostId], references: [id], onDelete: SetNull)

  @@unique([rosterPatternId, guardId, patternDayIndex])
  @@index([rosterPatternId])
  @@index([guardId])
}

model SiteRosterManualOverride {
  id                    String              @id @default(cuid())
  companyId             String
  siteId                String
  guardId               String
  rosterDate            DateTime            @db.Date
  originalShiftCode     SiteRosterShiftCode?
  overrideShiftCode     SiteRosterShiftCode
  overrideShiftType     SiteRosterShiftType
  reason                String?
  doesChangeBasePattern Boolean             @default(false)
  createdBy             String?
  createdAt             DateTime            @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  guard   Employee @relation(fields: [guardId], references: [id], onDelete: Cascade)

  @@unique([siteId, guardId, rosterDate])
  @@index([companyId, siteId, rosterDate])
}

model SiteRosterGeneratedShift {
  id              String                   @id @default(cuid())
  companyId       String
  siteId          String
  guardId         String
  rosterDate      DateTime                 @db.Date
  shiftCode       SiteRosterShiftCode
  shiftType       SiteRosterShiftType
