model AttendanceException {
  id            String                  @id @default(cuid())
  companyId     String
  attendanceId  String?
  shiftId       String?
  employeeId    String?
  siteId        String?
  exceptionType AttendanceExceptionType
  severity      ExceptionSeverity
  description   String
  minutesLate   Int?
  minutesEarly  Int?
  detectedAt    DateTime                @default(now())
  status        ExceptionReviewStatus   @default(OPEN)
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  /// Deduplication key e.g. "MISSED_CLOCK_IN:shift:abc"
  dedupeKey     String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  site       Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  reviewedBy User?     @relation("ExceptionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([companyId, dedupeKey])
  @@index([companyId, status, severity])
  @@index([companyId, exceptionType])
  @@index([siteId])
  @@index([employeeId])
  @@index([shiftId])
  @@index([detectedAt])
}

enum DocumentCategory {
  EMPLOYEE
  SITE
  CLIENT
  ATTENDANCE
  INCIDENT
  EQUIPMENT
  COMPLIANCE
  BILLING
  REPORT
  OTHER
}

enum DocumentStatus {
  ACTIVE
  EXPIRED
  ARCHIVED
  PENDING_REVIEW
}

enum DocumentOrigin {
  UPLOADED
  GENERATED
}

enum DocumentLifecycleStatus {
  DRAFT
  REVIEW
  FINAL
  SUPERSEDED
  ARCHIVED
}

model ManagedDocument {
  id                   String                  @id @default(cuid())
  companyId            String
  title                String
  documentType         String
  category             DocumentCategory
  documentCategory     String?
  documentNumber       String?
  issuingAuthority     String?
  issueDate            DateTime?
  expiryDate           DateTime?
  doesNotExpire        Boolean                 @default(false)
  isSensitive          Boolean                 @default(false)
  fileUrl              String
  fileName             String
  mimeType             String
  size                 Int
  employeeId           String?
  siteId               String?
  clientId             String?
  clientContractId     String?
  incidentId           String?
  uploadedById         String
  verificationStatus   String                  @default("PENDING_VERIFICATION")
  verifiedById         String?
  verifiedAt           DateTime?
  rejectionReason      String?                 @db.Text
  notes                String?                 @db.Text
  status               DocumentStatus          @default(ACTIVE)
  origin               DocumentOrigin          @default(UPLOADED)
  sourceModule         String?
  sourceEntityType     String?
  sourceEntityId       String?
  lifecycleStatus      DocumentLifecycleStatus @default(FINAL)
  currentVersionId     String?
  replacedByDocumentId String?
  metadata             Json?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee       Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  site           Site?             @relation(fields: [siteId], references: [id], onDelete: SetNull)
  client         Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientContract ClientContract?   @relation(fields: [clientContractId], references: [id], onDelete: SetNull)
  incident       Incident?         @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  uploadedBy     User              @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  verifiedBy     User?             @relation("DocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  currentVersion DocumentVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       DocumentVersion[] @relation("DocumentVersions")

  @@index([companyId, category])
  @@index([companyId, documentCategory])
  @@index([companyId, status])
  @@index([companyId, verificationStatus])
  @@index([companyId, origin])
  @@index([sourceModule, sourceEntityId])
  @@index([currentVersionId])
  @@index([lifecycleStatus])
  @@index([employeeId])
  @@index([siteId])
  @@index([clientId])
  @@index([clientContractId])
  @@index([expiryDate])
}

model DocumentVersion {
  id            String          @id @default(cuid())
  companyId     String
  documentId    String
  versionNumber Int
  fileUrl       String
  fileName      String
  mimeType      String
  size          Int
  checksum      String?
  createdById   String?
  createdAt     DateTime        @default(now())
  changeSummary String?
  sourceType    String?
  metadata      Json?

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document   ManagedDocument   @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  createdBy  User?             @relation("DocumentVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  currentFor ManagedDocument[] @relation("CurrentVersion")

  @@unique([documentId, versionNumber])
  @@index([companyId])
  @@index([documentId])
  @@index([createdById])
}

