  updatedAt    DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  courseRuns CourseRun[]
  instructors AcademyInstructor[]
  classrooms AcademyClassroom[]

  @@index([companyId])
}

model Student {
  id                         String                            @id @default(cuid())
  companyId                  String
  studentNumber              String
  firstName                  String
  middleName                 String?
  lastName                   String
  preferredName              String?
  idType                     String? // national_id | passport | etc.
  idNumber                   String?
  dateOfBirth                DateTime?
  gender                     String?
  nationality                String?
  phone                      String?
  alternatePhone             String?
  email                      String?
  addressLine1               String?
  addressLine2               String?
  city                       String?
  province                   String?
  postalCode                 String?
  nextOfKinName              String?
  nextOfKinPhone             String?
  psiraProfileReference      String?
  psiraPreRegistrationStatus AcademyPsiraPreRegistrationStatus @default(unknown)
  status                     AcademyStudentStatus              @default(prospect)
  employeeId                 String?
  adminFeeStatus             AcademyAdminFeeStatus               @default(unpaid)
  adminFeePaidAt             DateTime?
  adminFeeAmount             Decimal?                            @db.Decimal(12, 2)
  adminFeeMethod             String?
  adminFeeReference          String?
  adminFeeNotes              String?                             @db.Text
