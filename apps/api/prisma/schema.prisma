// Plethora - Workforce & Payroll Management
// Multi-tenant ready schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Business details
  legalName            String?
  registrationNumber   String?
  taxNumber            String?
  address              String?
  phone                String?
  email                String?
  logoUrl              String?
  website              String?
  fax                  String?
  psiraRegistration    String?
  uifReference         String?
  payeReference        String? // PAYE ref starts with '7'
  sdlReference         String? // SDL ref starts with 'L'
  sdlLiableFrom        DateTime? // When company first exceeded R500k payroll
  monthlyPayrollTotals Json? // { "YYYY-MM": total } for rolling 12-month SDL tracking

  // Business settings & theme (JSON for flexibility)
  settings Json? // { currency, dateFormat, timezone, payrollPeriod, etc. }
  theme    Json? // { primaryColor, accentColor, mode: "light"|"dark"|"system" }

  users                 User[]
  employees             Employee[]
  sites                 Site[]
  whatsAppClockPendings WhatsAppClockPending[]
  shifts                Shift[]
  payrollRuns           PayrollRun[]
  auditLogs             AuditLog[]
  rosterAutomationRuns RosterAutomationRun[]
  payRules              PayRule[]
  payGrades             PayGrade[]
  employeeGroups        EmployeeGroup[]
  groupPayRules         GroupPayRule[]
  groupEarningsRules    GroupEarningsRule[]
  groupDeductionRules   GroupDeductionRule[]
  earningsRules         EarningsRule[]
  deductionRules        DeductionRule[]
  publicHolidays        PublicHoliday[]
  timesheets            Timesheet[]
  taskProjects          TaskProject[]
  tasks                 Task[]
  whatsappMessages      WhatsAppMessage[]

  siteRosterPatterns          SiteRosterPattern[]
  siteRosterManualOverrides   SiteRosterManualOverride[]
  siteRosterGeneratedShifts   SiteRosterGeneratedShift[]
  siteTimesheets              SiteTimesheet[]
  siteTimesheetRows           SiteTimesheetRow[]

  academyBranches         AcademyBranch[]
  academyStudents         Student[]
  academyStudentDocuments StudentDocument[]
  academyCourses          Course[]
  academyCourseRuns       CourseRun[]
  academyFeePlans         FeePlan[]
  academyEnrolments       Enrolment[]
  academyInvoices         AcademyInvoice[]
  academyPayments         AcademyPayment[]
  academyReceipts         AcademyReceipt[]
  academyProfile          AcademyProfile?
  academyInstructors      AcademyInstructor[]
  academyInstructorDocuments AcademyInstructorDocument[]
  academyClassrooms       AcademyClassroom[]
  academyAttendanceSessions AcademyAttendanceSession[]
  academyAttendanceRecords  AcademyAttendanceRecord[]
  academyAssessments      AcademyAssessment[]
  academyCertificates     AcademyCertificate[]
  academyComplianceDocuments AcademyComplianceDocument[]
  academyPolicyDocuments  AcademyPolicyDocument[]
  academyRenewalAlerts    AcademyRenewalAlert[]
  leaveSickNotes          LeaveSickNote[]

  // Management System Review — operational modules
  operationalAlerts       OperationalAlert[]
  attendanceExceptions    AttendanceException[]
  managedDocuments        ManagedDocument[]
  incidents               Incident[]
  approvalRequests        ApprovalRequest[]
  appNotifications        AppNotification[]
  clients                 Client[]
  payrollPeriodReadiness  PayrollPeriodReadiness[]
}

model User {
  id                           String    @id @default(cuid())
  companyId                    String
  name                         String
  email                        String    @unique
  passwordHash                 String
  passwordSetupRequired        Boolean   @default(false)
  passwordSetupTokenHash       String?
  passwordSetupTokenExpiresAt  DateTime?
  passwordSetupTokenConsumedAt DateTime?
  role                         UserRole
  roleLabel                    String?
  /// When null, module access follows `role` defaults. When a non-empty JSON array of paths (e.g. ["/employees","/payroll"]), only those modules apply; Admin with null = full access, Admin with a list = scoped like other users.
  moduleAccess                 Json?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  company                  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  auditLogs                AuditLog[]
  tasksCreated             Task[]
  taskComments             TaskComment[]
  taskAttachments          TaskAttachment[]
  studentDocumentsUploaded StudentDocument[]
  academyPaymentsVerified  AcademyPayment[]  @relation("AcademyPaymentVerifiedBy")
  academyReceiptsIssued    AcademyReceipt[]  @relation("AcademyReceiptIssuedBy")
  academyAttendanceMarked  AcademyAttendanceRecord[] @relation("AcademyAttendanceMarkedBy")
  academyCertificatesIssued AcademyCertificate[] @relation("AcademyCertificateIssuedBy")
  academyComplianceVerified AcademyComplianceDocument[] @relation("AcademyComplianceVerifiedBy")
  academyInstructorDocumentsUploaded AcademyInstructorDocument[] @relation("AcademyInstructorDocumentUploadedBy")
  academyInstructorDocumentsVerified AcademyInstructorDocument[] @relation("AcademyInstructorDocumentVerifiedBy")
  refreshTokens                    RefreshToken[]

  // MSR relations
  supervisedSites                  Site[]                    @relation("SiteSupervisor")
  alertsAssigned                   OperationalAlert[]        @relation("AlertAssignedTo")
  alertsResolved                   OperationalAlert[]        @relation("AlertResolvedBy")
  exceptionsReviewed               AttendanceException[]     @relation("ExceptionReviewedBy")
  documentsUploaded                ManagedDocument[]         @relation("DocumentUploadedBy")
  incidentsReported                Incident[]                @relation("IncidentReportedBy")
  incidentsSupervised              Incident[]                @relation("IncidentAssignedSupervisor")
  approvalsRequested               ApprovalRequest[]         @relation("ApprovalRequestedBy")
  approvalsToReview                ApprovalRequest[]         @relation("ApprovalApprover")
  notificationsReceived            AppNotification[]
  clientProfile                    Client?

  @@index([companyId])
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  replacedByTokenId String?
  userAgent         String?
  ipAddress         String?

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces   RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

enum UserRole {
  admin
  operations_manager
  hr_payroll
  supervisor
  controller
  client
}

model Employee {
  id             String         @id @default(cuid())
  companyId      String
  employeeNumber String         @default(cuid()) // Unique per company - auto-generated for existing rows, can be set on create
  firstName      String
  lastName       String
  idNumber       String?
  phone          String?
  status         EmployeeStatus
  hourlyRate     Decimal?       @db.Decimal(10, 2) // For Guards
  monthlySalary  Decimal?       @db.Decimal(12, 2) // For Office staff (fixed monthly)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Employee type: office (Labour Law) vs security/guard (PSIRA)
  employeeType String  @default("security") // "office" | "security"
  jobRole      String? // e.g. "Security Officer", "HR Manager"

  // Labour Law (BCEA) - office staff
  dateOfBirth       DateTime?
  gender            String? // M/F
  maritalStatus     String? // single, married, divorced, widowed
  email             String?
  physicalAddress   String?
  postalAddress     String?
  postalCode        String?
  taxNumber         String?
  taxDirectiveNumber String?
  taxDirectiveRate   Decimal? @db.Decimal(5, 2) // Fixed PAYE % from SARS directive (0–100)
  bankName          String?
  bankAccountNumber String?
  bankBranchCode    String?
  commencementDate  DateTime?
  occupation        String?
  placeOfWork       String?
  ordinaryHours     String? // e.g. "45 hours/week"
  ordinaryDays      String? // e.g. "Mon-Fri"
  overtimeRate      Decimal?  @db.Decimal(10, 2)
  payFrequency      String? // weekly, bi-weekly, monthly
  leaveEntitlement  String?
  noticePeriod      String?
  previousService   String?

  // PSIRA - security staff
  psiraNumber           String?
  psiraExpiryDate       DateTime?
  securityServiceType   String? // guarding, patrolling, close_protection, etc.
  nextOfKin1Name        String?
  nextOfKin1Phone       String?
  nextOfKin2Name        String?
  nextOfKin2Phone       String?
  nextOfKin3Name        String?
  nextOfKin3Phone       String?
  residedOutsideSA      Boolean?
  militaryPoliceService Boolean?
  criminalInvestigation Boolean?
  mentallyUnstable      Boolean?
  trainingCompleted     Boolean?

  gradeId                     String?
  groupId                     String?
  company                     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  grade                       PayGrade?              @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  group                       EmployeeGroup?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  shifts                      Shift[]
  payrollItems                PayrollItem[]
  siteAssignments             SiteAssignment[]
  guardSiteEligibilities      GuardSiteEligibility[]
  siteRosterPatternCells      SiteRosterPatternCell[]
  siteRosterManualOverrides   SiteRosterManualOverride[]
  siteRosterGeneratedShifts   SiteRosterGeneratedShift[]
  plannedSiteTimesheetRows    SiteTimesheetRow[]        @relation("PlannedTimesheetGuard")
  actualSiteTimesheetRows     SiteTimesheetRow[]        @relation("ActualTimesheetGuard")
  timesheets                  Timesheet[]
  leaveRecords                LeaveRecord[]
  leaveSickNotes              LeaveSickNote[]
  leaveRequests               LeaveRequest[]
  employeeDeductions          EmployeeDeduction[]
  whatsappMessages            WhatsAppMessage[]
  whatsAppClockPendings       WhatsAppClockPending[]
  academyLinkedStudents       Student[]              @relation("AcademyStudentEmployee")
  academyCourseRunsInstructed CourseRun[]            @relation("CourseRunInstructor")
  attendanceExceptions        AttendanceException[]
  managedDocuments            ManagedDocument[]
  operationalAlerts           OperationalAlert[]

  @@unique([companyId, employeeNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, employeeType])
  @@index([companyId, groupId])
  @@index([gradeId])
  @@index([groupId])
  @@index([status])
  @@index([employeeType])
}

enum EmployeeStatus {
  applicant
  hired
  training
  active
  reliever
  suspended
  offboarded
}

model Site {
  id                         String   @id @default(cuid())
  companyId                  String
  name                       String
  location                   String? // Legacy/short name
  physicalAddress            String? // Full physical address
  contactPersonName          String?
  contactPersonPhone         String?
  /// Extended client contact (email) — complements contactPersonName/Phone
  clientContactEmail         String?
  contractOrServiceAgreement String? // Contract reference or description
  contractStartDate          DateTime?
  contractEndDate            DateTime?
  serviceType                String? // guarding, access_control, patrols, etc.
  monthlyRevenue             Decimal? @db.Decimal(12, 2) // Optional - for labour % and profitability
  /// Site supervisor (User with supervisor/ops role)
  supervisorId               String?
  riskLevel                  SiteRiskLevel @default(LOW)
  siteStatus                 SiteOperationalStatus @default(ACTIVE)
  siteInstructions           String?  @db.Text
  /// Linked client for portal isolation (optional)
  clientId                   String?
  /// Geofence center (WGS84). All three geofence fields must be set to enforce clock-in location on WhatsApp.
  latitude                   Decimal? @db.Decimal(10, 7)
  longitude                  Decimal? @db.Decimal(10, 7)
  geofenceRadiusMeters       Int?
  /// Shown on the shift roster sheet / PDF under “Site rules” (e.g. gender mix per shift).
  rosterSiteRules            String?  @db.Text
  rosterDayShiftGender       String? // male | female | any — roster display only
  rosterNightShiftGender     String? // male | female | any
  /// Minimum guards rostered on each day / night shift (auto-roster and coverage checks).
  rosterDayShiftGuardsRequired   Int @default(1)
  rosterNightShiftGuardsRequired Int @default(1)
  /// Extra lines on the shift roster sheet / PDF (operational notes).
  rosterSheetNotes           String?  @db.Text
  rosterDayShiftGenderMode     String?
  rosterNightShiftGenderMode   String?
  rosterDayShiftCustomMales    Int?
  rosterDayShiftCustomFemales  Int?
  rosterNightShiftCustomMales  Int?
  rosterNightShiftCustomFemales Int?
  dayShiftEnabled              Boolean  @default(true)
  nightShiftEnabled            Boolean  @default(true)
  /// Automatic roster generation from payroll calendar.
  autoRosterEnabled            Boolean   @default(false)
  autoRosterMinCoveragePercent Int       @default(100)
  autoRosterLastRunAt          DateTime?
  autoRosterLastStatus         String?
  /// Site-specific roster calendar and continuous-pattern automation state.
  rosterPeriodCalendarId       String?
  rosterContinuityState        RosterContinuityState @default(not_setup)
  rosterMaintainedThrough      DateTime? @db.Date
  rosterLastReconciledAt       DateTime?
  rosterLastReconciliationStatus String?
  rosterContinuityPauseReason  String?   @db.Text
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supervisor     User?            @relation("SiteSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  client         Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  posts                    SitePost[]
  assignedGuards           SiteAssignment[]
  guardSiteEligibilities   GuardSiteEligibility[]
  coverageRequirements     CoverageRequirement[]
  rosterAutomationRuns RosterAutomationRun[]
  shifts         Shift[]
  siteRosterPatterns SiteRosterPattern[]
  siteRosterManualOverrides SiteRosterManualOverride[]
  siteRosterGeneratedShifts SiteRosterGeneratedShift[]
  siteTimesheets SiteTimesheet[]
  siteTimesheetRows SiteTimesheetRow[]
  operationalAlerts OperationalAlert[]
  attendanceExceptions AttendanceException[]
  managedDocuments ManagedDocument[]
  incidents Incident[]
  tasks Task[]

  @@index([companyId])
  @@index([companyId, siteStatus])
  @@index([companyId, rosterContinuityState], map: "Site_rosterContinuityState_idx")
  @@index([supervisorId])
  @@index([clientId])
  @@index([contractEndDate])
  @@index([riskLevel])
}

model RosterAutomationRun {
  id              String    @id @default(cuid())
  companyId       String
  siteId          String
  periodStart     DateTime
  periodEnd       DateTime
  status          String
  coveragePercent Int?
  planSnapshot    Json?
  warnings        Json?
  errorMessage    String?
  appliedAt       DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([siteId, createdAt])
}

model SiteAssignment {
  id             String                   @id @default(cuid())
  siteId         String
  employeeId     String
  assignedAt     DateTime                 @default(now())
  assignmentType SiteGuardAssignmentType  @default(PERMANENT)
  priority       Int                      @default(0)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  isActive       Boolean                  @default(true)

  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([siteId, employeeId])
  @@index([siteId])
  @@index([employeeId])
}

enum SiteGuardAssignmentType {
  PERMANENT
  RELIEVER
  TEMPORARY
}

model SitePost {
  id        String   @id @default(cuid())
  siteId    String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site                 Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  guardEligibilities   GuardSiteEligibility[]
  coverageRequirements CoverageRequirement[]
  siteRosterPatternCells SiteRosterPatternCell[]
  siteRosterGeneratedShifts SiteRosterGeneratedShift[]

  @@index([siteId])
  @@map("SitePost")
}

model GuardSiteEligibility {
  id         String   @id @default(cuid())
  siteId     String
  employeeId String
  sitePostId String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sitePost SitePost @relation(fields: [sitePostId], references: [id], onDelete: Cascade)

  @@unique([siteId, employeeId, sitePostId])
  @@index([siteId])
  @@index([sitePostId])
  @@index([employeeId])
}

model CoverageRequirement {
  id             String   @id @default(cuid())
  siteId         String
  sitePostId     String
  shiftTypeCode  String
  guardsRequired Int      @default(1)
  genderRule     String   @default("any")
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sitePost SitePost @relation(fields: [sitePostId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([sitePostId])
}

model Shift {
  id             String      @id @default(cuid())
  companyId      String
  employeeId     String
  siteId         String
  shiftType      String? // day | night
  legacyPostName String?
  startTime      DateTime
  endTime        DateTime
  status         ShiftStatus
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  rosterGeneratedSource SiteRosterGeneratedShift? @relation("RosterPublishedShift")

  @@index([companyId])
  @@index([companyId, startTime])
  @@index([companyId, employeeId, startTime])
  @@index([companyId, siteId, startTime])
  @@index([companyId, status, startTime])
  @@index([employeeId])
  @@index([siteId])
  @@index([startTime])
  @@index([status])
}

enum ShiftStatus {
  created
  assigned
  active
  completed
  verified
}

model Attendance {
  id            String    @id @default(cuid())
  shiftId       String
  clockIn       DateTime?
  clockOut      DateTime?
  clockInLat    Decimal?  @db.Decimal(10, 7)
  clockInLng    Decimal?  @db.Decimal(10, 7)
  clockOutLat   Decimal?  @db.Decimal(10, 7)
  clockOutLng   Decimal?  @db.Decimal(10, 7)
  hoursWorked   Decimal?  @db.Decimal(10, 2)
  overtimeHours Decimal?  @db.Decimal(10, 2)
  status        String    @default("pending")
  source        String    @default("clock_in") // "clock_in" | "manual"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId])
  @@index([shiftId])
}

model PayrollRun {
  id                   String        @id @default(cuid())
  companyId            String
  periodStart          DateTime
  periodEnd            DateTime
  status               PayrollStatus
  lockedAt             DateTime?
  calculatedAt         DateTime?
  calculationSnapshot  Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items      PayrollItem[]
  timesheets Timesheet[]

  @@index([companyId])
  @@index([companyId, periodStart, periodEnd])
  @@index([companyId, status])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([status])
}

enum PayrollStatus {
  draft
  calculated
  approved
  paid
}

model PayrollItem {
  id               String   @id @default(cuid())
  payrollRunId     String
  employeeId       String
  hoursWorked      Decimal  @db.Decimal(10, 2)
  overtimeHours    Decimal  @db.Decimal(10, 2)
  basePay          Decimal  @db.Decimal(12, 2)
  overtimePay      Decimal  @db.Decimal(12, 2)
  sundayPay        Decimal? @db.Decimal(12, 2)
  publicHolidayPay Decimal? @db.Decimal(12, 2)
  grossPay         Decimal  @default(0) @db.Decimal(12, 2)
  deductions       Decimal  @db.Decimal(12, 2)
  netPay           Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payslip    Payslip?

  @@index([payrollRunId])
  @@index([employeeId])
}

model PayRule {
  id         String   @id @default(cuid())
  companyId  String
  ruleType   String // "overtime" | "sunday" | "public_holiday"
  multiplier Decimal  @db.Decimal(5, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, ruleType])
  @@index([companyId])
}

model PayGrade {
  id         String   @id @default(cuid())
  companyId  String
  groupId    String? // null = company default; set = group-specific
  name       String // e.g. "Grade A", "Senior Guard"
  hourlyRate Decimal  @db.Decimal(10, 2)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group     EmployeeGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@index([companyId])
  @@index([groupId])
}

model EmployeeGroup {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees           Employee[]
  payGrades           PayGrade[]
  groupPayRules       GroupPayRule[]
  groupEarningsRules  GroupEarningsRule[]
  groupDeductionRules GroupDeductionRule[]

  @@index([companyId])
}

model GroupPayRule {
  id         String   @id @default(cuid())
  companyId  String
  groupId    String
  ruleType   String // "overtime" | "sunday" | "public_holiday"
  multiplier Decimal  @db.Decimal(5, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group   EmployeeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, ruleType])
  @@index([companyId])
  @@index([groupId])
}

model GroupEarningsRule {
  id        String   @id @default(cuid())
  companyId String
  groupId   String
  name      String // e.g. "Transport", "Uniform allowance"
  type      String // "fixed" | "percentage"
  amount    Decimal? @db.Decimal(12, 2)
  rate      Decimal? @db.Decimal(5, 2)
  appliesTo String   @default("all") // "all" | "security" | "office"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group   EmployeeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([groupId])
}

model GroupDeductionRule {
  id          String   @id @default(cuid())
  companyId   String
  groupId     String
  name        String
  type        String // "fixed" | "percentage"
  amount      Decimal? @db.Decimal(12, 2)
  rate        Decimal? @db.Decimal(5, 2)
  appliesTo   String   @default("all") // "all" | "security" | "office"
  employeeIds Json?
  isOptional  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group   EmployeeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([groupId])
}

model EarningsRule {
  id        String   @id @default(cuid())
  companyId String
  name      String // e.g. "Transport", "Uniform allowance"
  type      String // "fixed" | "percentage"
  amount    Decimal? @db.Decimal(12, 2)
  rate      Decimal? @db.Decimal(5, 2)
  appliesTo String   @default("all") // "all" | "security" | "office"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model DeductionRule {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  type        String // "fixed" | "percentage"
  amount      Decimal? @db.Decimal(12, 2)
  rate        Decimal? @db.Decimal(5, 2)
  appliesTo   String   @default("all") // "all" | "security" | "office"
  employeeIds Json?
  isOptional  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeDeductions EmployeeDeduction[]

  @@index([companyId])
}

model EmployeeDeduction {
