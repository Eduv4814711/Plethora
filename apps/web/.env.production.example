# Plethora Web — AWS EC2 (non-Docker) production environment template
#
# On the EC2 host, copy this to apps/web/.env.production (read by `next build`
# and `next start`), then fill in real values:
#   cp apps/web/.env.production.example apps/web/.env.production
#
# NEXT_PUBLIC_* values are inlined at BUILD time, so build the web app AFTER
# this file exists. Never commit a filled-in copy.

NODE_ENV=production

# Public API origin the browser/Next.js rewrites proxy to (no trailing slash).
# This must be the api subdomain served by the ALB over HTTPS.
NEXT_PUBLIC_API_URL=https://api.plethora.quickbophasecurity.co.za

# Leave empty: the API serves routes at the origin root (/health, /auth, ...).
NEXT_PUBLIC_API_PATH_PREFIX=
