# Browser calls use relative /api; Next.js rewrites those to this base URL.
# Local dev: Fastify on port 3001. Production: your public API origin (https, no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Leave empty when the API serves routes at the origin root (/health, /auth, …).
# Set to /api only if your API is behind a path prefix (uncommon for Railway/local).
NEXT_PUBLIC_API_PATH_PREFIX=
