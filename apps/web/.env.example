# Browser calls use relative /api; Next.js rewrites those to this base URL.
# Local dev: Fastify on port 3001. Production: your public API origin (https, no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:3001

# When the API is deployed as Vercel Serverless, routes are under /api on that host (e.g. /api/health).
# Set to /api so rewrites target https://your-api.vercel.app/api/... The API strips this prefix.
# Leave empty for APIs served at the origin root (Railway, local, etc.).
NEXT_PUBLIC_API_PATH_PREFIX=
