# Plethora Web — AWS ECS Fargate environment template
#
# Copy for local reference only — do NOT commit a filled-in copy:
#   cp apps/web/.env.aws.example apps/web/.env.aws
#
# See docs/AWS_ENVIRONMENT_VARIABLES.md for build-time vs runtime variables.
#
# Do not commit real values. Add apps/web/.env.aws to .gitignore if you create one locally.

# Runtime (ECS task definition — web service)
NODE_ENV=production
PORT=3000

# Build-time only — baked into the Docker image via Dockerfile.web build-args.
# Set when running: npm run docker:build:web  or  docker build -f Dockerfile.web ...
# Must be the public API origin (https://api.example.com), no trailing slash.
NEXT_PUBLIC_API_URL=

# Leave empty when the API serves routes at the origin root (/health, /auth, /webhook, …).
NEXT_PUBLIC_API_PATH_PREFIX=

# Build-time only — Dockerfile.web sets this automatically; do not set on the running ECS task.
DOCKER_BUILD=1
