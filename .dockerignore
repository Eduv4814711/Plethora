# Git
.git
**/.git
.gitignore

# Dependencies & build outputs
**/node_modules
apps/web/.next
**/.next
apps/api/dist
**/dist

# Secrets & local env (never bake into images)
.env
.env.*
**/.env*

# Runtime uploads & local data
uploads
**/uploads

# Editor / tooling / platform-specific
.cursor
**/.cursor
.vercel
**/.vercel

# Tests & logs
coverage
**/coverage
*.log
**/*.log

# OS junk
.DS_Store

# TypeScript incremental
**/*.tsbuildinfo

