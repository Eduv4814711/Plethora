# Authoritative .dockerignore for the Docker build context (repo root).
# Both apps/api/Dockerfile and apps/web/Dockerfile use this repo root as their
# build context, so this file controls what is copied into every image.

# Dependencies (re-installed cleanly inside the image via `npm ci`)
node_modules
**/node_modules

# Build output (rebuilt inside the image)
dist
**/dist
.next
**/.next
**/*.tsbuildinfo

# Secrets / local env files (provided at runtime, never baked into images)
.env
.env.*
!.env.example
!.env.production.example
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example

# Local runtime data that must never be copied into an image
apps/api/uploads
backups

# VCS / tooling / editor
.git
.gitignore
.github
.vercel
**/.vercel
.cursor
.turbo

# Logs, coverage, caches
*.log
**/*.log
coverage
**/coverage
.DS_Store

# Deployment artifacts not needed inside images
deploy.sh
DEPLOYMENT.md
DEPLOYMENT_VM.md
docs
README.md
ecosystem.config.cjs
