# Dependencies and build artifacts (reinstalled or rebuilt in image)
node_modules
**/node_modules
apps/api/dist
apps/web/.next
apps/web/out

# Local env and secrets (inject at runtime via ECS task definition)
.env
.env.*
!.env.example
apps/api/.env
apps/web/.env.local

# Git and editor
.git
.gitignore
.cursor
**/.cursor

# Documentation and CI (not needed in container images)
*.md
!README.md
docs
.github
cloudbuild.yaml
DEPLOYMENT.md
**/railway.toml

# Tests and coverage
**/__tests__
**/*.test.ts
**/*.spec.ts
coverage

# Uploads and runtime data (use EFS/S3 in production)
apps/api/uploads
**/uploads

# Archived migrations (not used by prisma migrate deploy)
apps/api/prisma/migrations_archived

# Misc local artifacts
terminals
agent-transcripts
*.log
.DS_Store
