NODE_ENV=production
HOST=0.0.0.0
PORT=3001

DATABASE_URL=${{Postgres.DATABASE_URL}}

JWT_SECRET=change_me_to_a_long_secure_secret
JWT_REFRESH_SECRET=change_me_to_a_different_long_secure_secret

FRONTEND_URL=https://plethora.quickbophasecurity.co.za
CORS_ORIGIN=https://plethora.quickbophasecurity.co.za

TRUST_PROXY=true
# Mount a Railway Volume at /data before using this path.
UPLOADS_DIR=/data/uploads

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WABA_ID=
WHATSAPP_TEMPLATES=

ENCRYPTION_KEY=change_me_to_required_format
CLOCK_IN_WINDOW_MINUTES=15

# Scheduled auto-roster cron (POST /internal/cron/auto-roster). Min 16 chars.
CRON_SECRET=change_me_to_a_long_random_secret

# Optional when Railway provides a system Chromium instead of bundled Puppeteer.
PUPPETEER_EXECUTABLE_PATH=
