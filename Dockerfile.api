# Plethora API — Fastify + Prisma (npm workspace monorepo)
#
# Build from repository root:
#   docker build -f Dockerfile.api -t plethora-api .
#
# Run (set secrets via env file or orchestrator):
#   docker run --rm -p 3001:3001 --env-file apps/api/.env \
#     -e RUN_MIGRATIONS=true \
#     -v plethora-uploads:/app/apps/api/uploads \
#     plethora-api
#
# Requires Node 24.x (see package.json engines).

# syntax=docker/dockerfile:1

FROM node:24-bookworm-slim AS base

# Prisma (OpenSSL) + Puppeteer PDF generation (Chromium)
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    chromium \
    fonts-liberation \
    libnss3 \
    libatk-bridge2.0-0 \
    libcups2 \
    libgbm1 \
    libasound2 \
    libxss1 \
    libgtk-3-0 \
    libxshmfence1 \
    libglu1-mesa \
  && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# -----------------------------------------------------------------------------
# Install all dependencies (needed for TypeScript build)
# -----------------------------------------------------------------------------
FROM base AS deps

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/

RUN npm ci --workspace=api

# -----------------------------------------------------------------------------
# Compile TypeScript, Prisma client, copy email/PDF templates
# -----------------------------------------------------------------------------
FROM base AS build

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY apps/api ./apps/api

RUN npm run build --workspace=api

# -----------------------------------------------------------------------------
# Production image: production deps + compiled dist + Prisma schema/migrations
# -----------------------------------------------------------------------------
FROM base AS runner

WORKDIR /app

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3001

RUN groupadd --system plethora \
  && useradd --system --gid plethora --home-dir /app --shell /usr/sbin/nologin plethora

COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/

RUN npm ci --workspace=api --omit=dev \
  && npm cache clean --force

COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/prisma ./apps/api/prisma

# Query engine must match this image (fresh npm ci, not build-stage node_modules).
RUN cd apps/api && npx prisma generate

COPY scripts/docker-api-entrypoint.sh /usr/local/bin/docker-api-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-api-entrypoint.sh

RUN mkdir -p /app/apps/api/uploads \
  && chown -R plethora:plethora /app

USER plethora

WORKDIR /app/apps/api

EXPOSE 3001

VOLUME ["/app/apps/api/uploads"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3001/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["docker-api-entrypoint.sh"]
CMD ["node", "dist/index.js"]
