# Plethora API — build from monorepo root: docker build -f Dockerfile.api .
# Used for Railway (root Dockerfile, repo as build context) and Google Cloud Run.
FROM node:20-bookworm-slim AS builder

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Workspace install needs the root manifest + lockfile and every workspace package.json.
COPY package.json package-lock.json ./
COPY apps ./apps

RUN npm ci

RUN npm run build --workspace=api

# Drop devDependencies from the hoisted install (keeps Prisma client + runtime deps).
RUN npm prune --omit=dev

FROM node:20-bookworm-slim AS runner

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates wget \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV NODE_ENV=production
# Default port for local `docker run` and platforms (Cloud Run, Fly, etc.) that
# don't inject one. Railway/Cloud Run override $PORT at runtime; the API reads it.
ENV PORT=8080

COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/apps/web/package.json ./apps/web/
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma

EXPOSE 8080

# Local-only liveness probe; Railway/Cloud Run drive their own healthchecks
# (see apps/api/railway.toml `healthcheckPath`).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --quiet --spider "http://127.0.0.1:${PORT}/health" || exit 1

# Default: migrate then listen (Cloud Run / docker run). Railway overrides via
# apps/api/railway.toml to pre-deploy migrate + `npm run start:server`.
CMD ["npm", "start", "--workspace=api"]
