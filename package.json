{
  "name": "plethora",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:api": "npm run dev --workspace=api",
    "clean:web": "node -e \"try{require('fs').rmSync('apps/web/.next',{recursive:true,force:true})}catch(e){}\"",
    "check:web-port": "node apps/web/scripts/check-port.mjs",
    "dev:web": "npm run check:web-port && npm run clean:web && npm run dev --workspace=web",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=web",
    "build:api": "npm run build --workspace=api",
    "db:generate": "npm run db:generate --workspace=api",
    "db:migrate": "npm run db:migrate --workspace=api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=api",
    "db:migrate:status": "npm run db:migrate:status --workspace=api",
    "db:push": "npm run db:push --workspace=api",
    "db:seed": "npm run db:seed --workspace=api",
    "db:reset-admin": "npm run db:reset-admin --workspace=api",
    "db:sync-prod": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-prod-to-local.ps1",
    "test": "npm run test --workspace=api && npm run test --workspace=web",
    "test:api": "npm run test --workspace=api",
    "test:web": "npm run test --workspace=web"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "typescript": "^5.9.3"
  },
  "//react": "next hoists to the root, so React must live there too — otherwise npm satisfies Next's peer with its own React 18 while apps/web uses 19, and React 18 cannot render React 19 elements.",
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "overrides": {
    "fast-uri": "3.1.2",
    "tar": "7.5.15",
    "postcss": "8.5.20",
    "dompurify": "3.4.12",
    "vite": "8.1.5",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.0.0-rc.16"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "bcrypt@6.0.0": true,
    "core-js@3.49.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.8.0": true,
    "puppeteer@25.3.0": true,
    "sharp@0.34.5": true
  }
}
