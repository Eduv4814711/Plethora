{
  "name": "plethora",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:api": "npm run dev --workspace=api",
    "clean:web": "node -e \"try{require('fs').rmSync('apps/web/.next',{recursive:true,force:true})}catch(e){}\"",
    "dev:web": "npm run clean:web && npm run dev --workspace=web",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=web",
    "build:api": "npm run build --workspace=api",
    "db:generate": "npm run db:generate --workspace=api",
    "db:migrate": "npm run db:migrate --workspace=api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=api",
    "db:push": "npm run db:push --workspace=api",
    "db:add-module-access": "npm run db:add-module-access --workspace=api",
    "db:seed": "npm run db:seed --workspace=api",
    "docker:build:api": "docker build -f Dockerfile.api -t plethora-api .",
    "docker:build:web": "docker build -f Dockerfile.web --build-arg NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://localhost:3001} --build-arg NEXT_PUBLIC_API_PATH_PREFIX=${NEXT_PUBLIC_API_PATH_PREFIX:-} -t plethora-web .",
    "docker:run:api": "docker run --rm -p 3001:3001 --env-file apps/api/.env -e RUN_MIGRATIONS=true -v plethora-uploads:/app/apps/api/uploads plethora-api",
    "docker:run:web": "docker run --rm -p 3000:3000 plethora-web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "fast-uri": "3.1.2",
    "tar": "7.5.15",
    "postcss": "8.5.10",
    "dompurify": "3.4.5"
  }
}
