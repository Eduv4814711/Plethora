# Plethora — Docker / Cloud Run / local orchestration reference
#
# Copy service-specific files for day-to-day dev:
#   cp apps/api/.env.example apps/api/.env
#   cp apps/web/.env.example apps/web/.env.local
#
# For docker compose or Cloud Run, map these variables to each service.
# Do not commit real secrets.

# =============================================================================
# Shared / infrastructure
# =============================================================================

# PostgreSQL (API only). Use a managed instance URL in production.
DATABASE_URL=postgresql://user:password@postgres:5432/plethora?schema=public

# =============================================================================
# API (Dockerfile.api) — runtime
# =============================================================================

NODE_ENV=production
HOST=0.0.0.0
PORT=3001

# Required in production: two different random strings, each >= 32 characters
JWT_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated browser origins allowed for CORS (include your web app URL)
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Apply Prisma migrations on container start (docker-api-entrypoint.sh)
RUN_MIGRATIONS=true

# Writable uploads directory (volume recommended in Docker/Kubernetes)
# UPLOADS_DIR=/app/apps/api/uploads

# WhatsApp Cloud API (optional until enabled)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0

# PDF via puppeteer-core (Chromium is installed in Dockerfile.api)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# =============================================================================
# Web (Dockerfile.web) — build-time (docker build --build-arg)
# =============================================================================

# Public API origin used by the browser and Next.js rewrites (/api → API).
# Production example: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# Leave empty when API routes are at the origin root (/health, /auth, …)
NEXT_PUBLIC_API_PATH_PREFIX=

# =============================================================================
# Web — runtime (standalone server)
# =============================================================================

HOSTNAME=0.0.0.0
PORT=3000

# =============================================================================
# Google Cloud Build (cloudbuild.yaml substitutions)
# =============================================================================

# _REGION=europe-west1
# _REPOSITORY=plethora
# _API_URL=https://api.yourdomain.com
