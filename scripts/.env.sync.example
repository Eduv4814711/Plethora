# Config for scripts/sync-prod-to-local.ps1
# Copy to scripts/.env.sync and fill in real values. .env.sync is gitignored.
#
# WARNING: the sync DESTROYS the local database on every run. Point
# LOCAL_DATABASE_URL at a disposable development database only.

# Railway production. Read-only as far as this script is concerned (pg_dump).
PROD_DATABASE_URL=postgresql://user:password@host.proxy.rlwy.net:5432/railway

# Local target. Dropped and recreated on every sync.
# Special characters in the password must be URL-encoded (@ becomes %40).
LOCAL_DATABASE_URL=postgresql://postgres:password@localhost:5432/plethora

# Postgres client tools. Optional - defaults to the path below.
PG_BIN=C:\Program Files\PostgreSQL\18\bin
