# Plethora Web — Next.js 14 (npm workspace monorepo)
#
# Build from repository root (NEXT_PUBLIC_* are baked in at build time):
#   docker build -f Dockerfile.web \
#     --build-arg NEXT_PUBLIC_API_URL=https://api.example.com \
#     -t plethora-web .
#
# Run:
#   docker run --rm -p 3000:3000 plethora-web
#
# Browser calls use /api/*; Next rewrites to NEXT_PUBLIC_API_URL (see next.config.js).
# Requires Node 24.x (see package.json engines).

# syntax=docker/dockerfile:1

FROM node:24-bookworm-slim AS base

# -----------------------------------------------------------------------------
# Install dependencies
# -----------------------------------------------------------------------------
FROM base AS deps

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/

RUN npm ci --workspace=web

# -----------------------------------------------------------------------------
# Production build (standalone server bundle for a minimal runtime image)
# -----------------------------------------------------------------------------
FROM base AS build

WORKDIR /app

# Build-time public env (embedded in client bundle and rewrite config)
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ARG NEXT_PUBLIC_API_PATH_PREFIX=

ENV DOCKER_BUILD=1 \
    NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_API_PATH_PREFIX=${NEXT_PUBLIC_API_PATH_PREFIX} \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY apps/web ./apps/web

RUN npm run build --workspace=web

# -----------------------------------------------------------------------------
# Runtime: Next.js standalone output (monorepo layout under apps/web/)
# -----------------------------------------------------------------------------
FROM base AS runner

WORKDIR /app

ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    NEXT_TELEMETRY_DISABLED=1

RUN groupadd --system plethora \
  && useradd --system --gid plethora --home-dir /app --shell /usr/sbin/nologin plethora

# Standalone trace root is the monorepo; server.js lives under apps/web/
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public

RUN chown -R plethora:plethora /app

USER plethora

WORKDIR /app/apps/web

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
