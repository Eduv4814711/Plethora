# =============================================================================
# Plethora ERP — production environment for the single-VM Docker Compose stack
# =============================================================================
#
# Copy this file to the deploy root and fill in REAL secrets:
#   cp /opt/plethora/apps/Plethora/.env.production.example /opt/plethora/.env
#   nano /opt/plethora/.env
#
# This single file is used two ways by docker-compose.yml:
#   1) ${VAR} interpolation in the compose file (POSTGRES_*, NEXT_PUBLIC_API_URL, paths)
#   2) env_file for the api container (JWT secrets, CORS, WhatsApp, etc.)
#
# NEVER commit a filled-in copy. Generate strong secrets with:
#   openssl rand -base64 48

# -----------------------------------------------------------------------------
# Runtime basics
# -----------------------------------------------------------------------------
NODE_ENV=production
TZ=Africa/Johannesburg

# -----------------------------------------------------------------------------
# Host paths (defaults already match the VM layout — usually leave unchanged)
# -----------------------------------------------------------------------------
# Where the repo is cloned and where persistent data / caddy config live.
REPO_DIR=/opt/plethora/apps/Plethora
DATA_ROOT=/opt/plethora/data
CADDY_CONFIG_DIR=/opt/plethora/caddy
# Absolute path to this env file (used as the api container env_file).
ENV_FILE=/opt/plethora/.env

# -----------------------------------------------------------------------------
# PostgreSQL (runs as the `postgres` container; data in /opt/plethora/data/postgres)
# -----------------------------------------------------------------------------
POSTGRES_USER=plethora_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=plethora_prod

# Connection string used by the API + Prisma. The host MUST be the internal
# service name `postgres` (NOT localhost). docker-compose.yml sets this value
# automatically from the POSTGRES_* vars above; it is repeated here for clarity
# and for running Prisma/psql commands manually.
DATABASE_URL=postgresql://plethora_admin:change_me@postgres:5432/plethora_prod?schema=public

# -----------------------------------------------------------------------------
# Redis (runs as the `redis` container; data in /opt/plethora/data/redis)
# -----------------------------------------------------------------------------
# Provisioned for caching/queues. Host MUST be the internal service name `redis`.
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Authentication secrets (REQUIRED in production)
# -----------------------------------------------------------------------------
# The API refuses to boot unless BOTH secrets are >= 32 chars, are different
# from each other, and are not placeholder/dev values.
JWT_SECRET=change_me_to_a_long_secure_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_to_a_DIFFERENT_long_secure_secret_32_chars
# NOTE: token lifetimes are currently fixed in code; JWT_EXPIRES_IN is reserved
# for future use and is safe to leave set.
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Public URLs / CORS
# -----------------------------------------------------------------------------
# Browser origin allowed by CORS + used for invite/password links. No trailing slash.
FRONTEND_URL=https://app.example.co.za
CORS_ORIGIN=https://app.example.co.za
# Public API origin (informational; the browser reaches the API via NEXT_PUBLIC_API_URL).
API_URL=https://api.example.co.za

# Build-time public API origin for the Next.js frontend (inlined into the bundle).
# This is read by `docker compose build` for the web image — must be the api domain.
NEXT_PUBLIC_API_URL=https://api.example.co.za
# Leave empty: the API serves routes at the origin root (/health, /auth, ...).
NEXT_PUBLIC_API_PATH_PREFIX=

# -----------------------------------------------------------------------------
# Uploads / storage (local disk -> /opt/plethora/data/uploads)
# -----------------------------------------------------------------------------
# docker-compose.yml sets STORAGE_DRIVER=local and UPLOADS_DIR=/app/uploads for
# the api container; the value below documents the in-container path.
UPLOADS_DIR=/app/uploads

# -----------------------------------------------------------------------------
# Reverse proxy / TLS
# -----------------------------------------------------------------------------
# Caddy terminates TLS; the API must trust X-Forwarded-* headers from it.
TRUST_PROXY=true

# -----------------------------------------------------------------------------
# Optional features
# -----------------------------------------------------------------------------
# WhatsApp Cloud API (leave blank to keep WhatsApp disabled). See docs/WHATSAPP_PRODUCTION.md
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Required only if encrypted SMTP settings are stored in the DB (>= 16 chars).
ENCRYPTION_KEY=

# Minutes before shift start that clock-in is allowed.
CLOCK_IN_WINDOW_MINUTES=15
